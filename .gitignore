# .NET and Visual Studio build output
.vs/
**/bin/
**/obj/
**/TestResults/
*.user
*.suo
*.pdb

# Published builds are generated by publish.ps1; distribute binaries as release assets
/publish/
/publish-*/
*.exe

# Local application data and backups must never be committed
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.bak
/backups/

# Local analysis/tooling artifacts
/graphify-out/
/graphify-*/
/ECC-main/
/.agents/

# Local isolated QA work copy and generated smoke data (never publish databases)
/SOFT2027-UX-QA-Phase-Copy/
/qa-artifacts/*/
/qa-artifacts/*.log
/qa-artifacts/*.txt
