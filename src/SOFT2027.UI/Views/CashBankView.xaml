<UserControl x:Class="SOFT2027.UI.Views.CashBankView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SOFT2027.Presentation.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CashBankViewModel}"
             Background="Transparent" Loaded="View_Loaded">
    <Border Style="{StaticResource PageContentCardStyle}" Margin="{StaticResource Layout_Margin_0_0_0_16}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="{StaticResource Layout_Margin_0_0_0_16}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Cash &amp; Bank" FontSize="{StaticResource TypePageTitle}" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" />
                    <TextBlock Text="Balances and recorded activity for cash and bank accounts." FontSize="{StaticResource TypeBody}" Foreground="{StaticResource MutedBrush}" Margin="{StaticResource Layout_Margin_0_4_0_0}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh balances" Command="{Binding LoadCommand}" Height="{StaticResource ButtonHeight}" Padding="{StaticResource Layout_Padding_14_0}" VerticalAlignment="Center" />
            </Grid>
            <DockPanel Grid.Row="1" Margin="{StaticResource Layout_Margin_0_0_0_14}">
                <Border Background="{StaticResource BlueLightBrush}" CornerRadius="{StaticResource Layout_CornerRadius_7}" Padding="{StaticResource Layout_Padding_14_10}" Margin="{StaticResource Layout_Margin_0_0_10_0}">
                    <StackPanel><TextBlock Text="CASH BALANCE" FontSize="{StaticResource TypeSmall}" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding CashBalance, StringFormat={StaticResource CurrencyStringFormat}}" FontSize="{StaticResource TypeSectionTitle}" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" /></StackPanel>
                </Border>
                <Border Background="{StaticResource GreenLightBrush}" CornerRadius="{StaticResource Layout_CornerRadius_7}" Padding="{StaticResource Layout_Padding_14_10}">
                    <StackPanel><TextBlock Text="BANK BALANCE" FontSize="{StaticResource TypeSmall}" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding BankBalance, StringFormat={StaticResource CurrencyStringFormat}}" FontSize="{StaticResource TypeSectionTitle}" FontWeight="Bold" Foreground="{StaticResource GreenBrush}" /></StackPanel>
                </Border>
                <TextBlock Text="{Binding ErrorMessage, Converter={StaticResource StatusMessageConverter}, ConverterParameter=Error}" Foreground="{Binding ErrorMessage, Converter={StaticResource StatusMessageConverter}, ConverterParameter=Color}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="{StaticResource Layout_Margin_14_0_0_0}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive" />
            </DockPanel>
            <TabControl Grid.Row="2">
                <TabItem Header="Cash transactions">
                    <DataGrid ItemsSource="{Binding CashTransactions}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Margin="{StaticResource Layout_Margin_0_8_0_0}" AutomationProperties.Name="Cash activity">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DATE" Binding="{Binding TransactionDate, StringFormat={StaticResource DateTimeStringFormat}}" Width="{StaticResource Layout_DataGridWidth_155}" />
                            <DataGridTextColumn Header="TYPE" Binding="{Binding TransactionType}" Width="{StaticResource Layout_DataGridWidth_110}" />
                            <DataGridTextColumn Header="REFERENCE" Binding="{Binding ReferenceNumber}" Width="{StaticResource Layout_DataGridWidth_150}" />
                            <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="MONEY IN" Binding="{Binding Debit, StringFormat={StaticResource CurrencyStringFormat}}" Width="{StaticResource Layout_DataGridWidth_110}" />
                            <DataGridTextColumn Header="MONEY OUT" Binding="{Binding Credit, StringFormat={StaticResource CurrencyStringFormat}}" Width="{StaticResource Layout_DataGridWidth_110}" />
                            <DataGridTextColumn Header="BALANCE" Binding="{Binding RunningBalance, StringFormat={StaticResource CurrencyStringFormat}}" Width="{StaticResource Layout_DataGridWidth_120}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Bank transactions">
                    <DataGrid ItemsSource="{Binding BankTransactions}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Margin="{StaticResource Layout_Margin_0_8_0_0}" AutomationProperties.Name="Bank activity">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DATE" Binding="{Binding TransactionDate, StringFormat={StaticResource DateTimeStringFormat}}" Width="{StaticResource Layout_DataGridWidth_155}" />
                            <DataGridTextColumn Header="TYPE" Binding="{Binding TransactionType}" Width="{StaticResource Layout_DataGridWidth_110}" />
                            <DataGridTextColumn Header="REFERENCE" Binding="{Binding ReferenceNumber}" Width="{StaticResource Layout_DataGridWidth_150}" />
                            <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="MONEY IN" Binding="{Binding Debit, StringFormat={StaticResource CurrencyStringFormat}}" Width="{StaticResource Layout_DataGridWidth_110}" />
                            <DataGridTextColumn Header="MONEY OUT" Binding="{Binding Credit, StringFormat={StaticResource CurrencyStringFormat}}" Width="{StaticResource Layout_DataGridWidth_110}" />
                            <DataGridTextColumn Header="BALANCE" Binding="{Binding RunningBalance, StringFormat={StaticResource CurrencyStringFormat}}" Width="{StaticResource Layout_DataGridWidth_120}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
