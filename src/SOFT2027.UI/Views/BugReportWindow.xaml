<Window x:Class="SOFT2027.UI.Views.BugReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Report a problem" Width="760" Height="820" MinWidth="760" MinHeight="500"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource PageBackgroundBrush}" Foreground="{StaticResource InkBrush}"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="BugReportCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource BtnStyle}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C50F1F" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border Margin="8" Background="{StaticResource PageBackgroundBrush}" BorderBrush="{StaticResource BorderTokenBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource BrandNavyBrush}" CornerRadius="8,8,0,0">
                <DockPanel LastChildFill="True">
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="×" FontFamily="Segoe UI Symbol" FontSize="15"
                            Style="{StaticResource BugReportCloseButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseButton_Click"
                            ToolTip="Close" AutomationProperties.Name="Close" />
                    <TextBlock Text="Report a problem" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0" />
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20,24,12">
                    <TextBlock Text="Send a clear report to the support team" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandNavyBrush}" />
                    <TextBlock Text="Nothing is sent automatically. Review any draft before sending. Do not include passwords, database contents, or full file paths. No screenshot is captured or attached."
                               TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,16" />

                    <Border Background="{StaticResource SurfaceWhiteBrush}" BorderBrush="{StaticResource BorderTokenBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,8"><TextBlock Text="App version" FontWeight="SemiBold"/><TextBlock x:Name="AppVersionValue" /></StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,8"><TextBlock Text="Windows version" FontWeight="SemiBold"/><TextBlock x:Name="WindowsVersionValue" TextWrapping="Wrap" /></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,8"><TextBlock Text="Screen / module" FontWeight="SemiBold"/><TextBlock x:Name="ModuleValue" /></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,8"><TextBlock Text="Date / time" FontWeight="SemiBold"/><TextBlock x:Name="DateValue" /></StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0"><TextBlock Text="Role" FontWeight="SemiBold"/><TextBlock x:Name="RoleValue" /></StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="Title *" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox x:Name="TitleBox" MinHeight="38" Padding="8" MaxLength="160" />
                    <TextBlock x:Name="TitleError" Text="Enter a short title." Foreground="{StaticResource ErrorTokenBrush}" Visibility="Collapsed" Margin="0,2,0,6" />

                    <TextBlock Text="What happened *" FontWeight="SemiBold" Margin="0,8,0,4" />
                    <TextBox x:Name="HappenedBox" MinHeight="78" Padding="8" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    <TextBlock x:Name="HappenedError" Text="Describe what happened." Foreground="{StaticResource ErrorTokenBrush}" Visibility="Collapsed" Margin="0,2,0,6" />

                    <TextBlock Text="Steps to reproduce" FontWeight="SemiBold" Margin="0,8,0,4" />
                    <TextBox x:Name="StepsBox" MinHeight="58" Padding="8" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    <TextBlock Text="Expected result" FontWeight="SemiBold" Margin="0,8,0,4" />
                    <TextBox x:Name="ExpectedBox" MinHeight="50" Padding="8" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0"><TextBlock Text="Severity" FontWeight="SemiBold" Margin="0,0,0,4"/><ComboBox x:Name="SeverityBox" SelectedIndex="2" Height="38"><ComboBoxItem Content="Critical"/><ComboBoxItem Content="Major"/><ComboBoxItem Content="Minor"/><ComboBoxItem Content="Suggestion"/></ComboBox></StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Repeatable" FontWeight="SemiBold" Margin="0,0,0,4"/><ComboBox x:Name="RepeatableBox" SelectedIndex="0" Height="38"><ComboBoxItem Content="Always"/><ComboBoxItem Content="Sometimes"/><ComboBoxItem Content="Once"/></ComboBox></StackPanel>
                    </Grid>

                    <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,14,0,6" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,14">
                        <Button x:Name="OpenFolderButton" Content="Open folder" Click="OpenFolder_Click" Style="{StaticResource BtnStyle}" Visibility="Collapsed" Margin="0,0,8,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Border x:Name="ActionBar" Grid.Row="2" Background="{StaticResource SurfaceWhiteBrush}"
                    BorderBrush="{StaticResource BorderTokenBrush}" BorderThickness="0,1,0,0" Padding="12,8">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Left" Content="Cancel" Click="Cancel_Click" Style="{StaticResource BtnStyle}" Margin="0,0,8,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Copy report" Click="Copy_Click" Style="{StaticResource BtnStyle}" Margin="0,0,8,0" />
                        <Button Content="Save to file" Click="Save_Click" Style="{StaticResource BtnStyle}" Margin="0,0,8,0" />
                        <Button Content="Send via Email app" Click="Mailto_Click" Style="{StaticResource BtnStyle}" Margin="0,0,8,0" />
                        <Button Content="Send via Gmail" Click="Gmail_Click" Style="{StaticResource BtnStyle}" />
                        <Button x:Name="WhatsAppButton" Content="Send via WhatsApp" Click="WhatsApp_Click" Style="{StaticResource BtnStyle}" Visibility="Collapsed" Margin="0,0,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
