<UserControl x:Class="SOFT2027.UI.Views.SalesEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:SOFT2027.UI.Behaviors"
             xmlns:vm="clr-namespace:SOFT2027.Presentation.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SalesEntryViewModel}"
             Background="Transparent"
             Loaded="View_Loaded">

    <UserControl.InputBindings>
        <KeyBinding Key="P" Modifiers="Alt" Command="{Binding UsePreviousPriceCommand}" />
        <KeyBinding Key="D" Modifiers="Alt" Command="{Binding UseDefaultPriceCommand}" />
        <KeyBinding Key="N" Modifiers="Alt" Command="{Binding EnterNewPriceCommand}" />
    </UserControl.InputBindings>

    <!-- Main Card Border (8px radius, white background, shadow from CardBorderStyle) -->
    <Border Style="{StaticResource CardBorderStyle}"
            HorizontalAlignment="Stretch"
            MaxWidth="1200"
            Padding="24"
            Margin="0,0,0,16">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: View Header Title & Subtitle -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <!-- Row 1: Accessibility & Error Notification Banner -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: Form Inputs Row (Responsive Wrap Layout) -->
                <RowDefinition Height="Auto" />
                <!-- Row 3: Customer/product pricing memory -->
                <RowDefinition Height="Auto" />
                <!-- Row 4: Items DataGrid -->
                <RowDefinition Height="*" MinHeight="260" />
                <!-- Row 5: Invoice Summary & Action Buttons -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ================================================================= -->
            <!-- ROW 0: CARD HEADER (Prototype .page-head & Title)                  -->
            <!-- ================================================================= -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="New Sale Invoice"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource NavyBrush}" />
                    <TextBlock Text="Customer → Product → Price Memory → Quantity → Save Invoice"
                               FontSize="13"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource SurfaceSubtleBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Mode: "
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="Offline Wholesale POS"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BlueBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================================================================= -->
            <!-- ROW 1: ACCESSIBILITY & ERROR NOTIFICATION BANNER                   -->
            <!-- ================================================================= -->
            <Border Grid.Row="1" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,12">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="Saved invoice" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" />
                    <ComboBox ItemsSource="{Binding SavedInvoices}" SelectedItem="{Binding SelectedSavedInvoice}" DisplayMemberPath="DisplayText" Width="330" Height="34" VerticalContentAlignment="Center" Tag="Recent saved invoices" AutomationProperties.Name="Choose a saved invoice from transaction history" />
                    <TextBox Text="{Binding DocumentLookupNumber, UpdateSourceTrigger=PropertyChanged}" Width="210" Height="34" VerticalContentAlignment="Center" Tag="Enter invoice number" AutomationProperties.Name="Saved invoice number" />
                    <Button Content="Preview / Print" Click="PreviewInvoice_Click" Margin="8,0,0,0" Padding="14,5" AutomationProperties.Name="Find and preview saved invoice" />
                    <Button Content="Preview latest saved" Click="PreviewLatestInvoice_Click" Margin="8,0,0,0" Padding="14,5" AutomationProperties.Name="Preview latest saved invoice" />
                    <Button Content="Print recent 4-up A4" Click="PreviewRecentInvoiceSheet_Click" Margin="8,0,0,0" Padding="14,5" AutomationProperties.Name="Preview up to four recent saved invoices on an A4 sheet" />
                </DockPanel>
            </Border>

            <TextBlock Grid.Row="2"
                       Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource RedBrush}"
                       FontWeight="SemiBold"
                       FontSize="13.5"
                       AutomationProperties.LiveSetting="Assertive"
                       AutomationProperties.Name="{Binding StatusAnnouncement}"
                       Margin="0,0,0,14" />

            <!-- ================================================================= -->
            <!-- ROW 2: FORM ROW (Customer & Product ComboBoxes 250px+ Height 40)   -->
            <!-- ================================================================= -->
            <Border Grid.Row="3"
                    Background="{StaticResource SurfaceSubtleBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,16,16,6"
                    Margin="0,0,0,18">
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                    <!-- Customer Selection (MinWidth 250, Height 40, Stretch) -->
                    <StackPanel Width="270" Margin="0,0,16,12">
                        <TextBlock Text="CUSTOMER *"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding Customers}"
                                  SelectedItem="{Binding SelectedCustomer}"
                                  DisplayMemberPath="CustomerName"
                                  Tag="Type or choose a customer"
                                  MinWidth="250"
                                  Height="40"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="Select Customer" />
                    </StackPanel>

                    <!-- Product Selection (MinWidth 250, Height 40, Stretch) -->
                    <StackPanel Width="290" Margin="0,0,16,12">
                        <TextBlock Text="PRODUCT *"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding Products}"
                                  SelectedItem="{Binding SelectedProduct}"
                                  DisplayMemberPath="ProductName"
                                  Tag="Type or choose a product"
                                  MinWidth="250"
                                  Height="40"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="Select Product" />
                    </StackPanel>

                    <!-- Quantity (Height 40) -->
                    <StackPanel Width="100" Margin="0,0,16,12">
                        <TextBlock Text="QUANTITY *"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="0,0,0,6" />
                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="e.g. 1"
                                 Height="40"
                                 behaviors:NumericTextBoxBehavior.IsEnabled="True"
                                 HorizontalAlignment="Stretch"
                                 HorizontalContentAlignment="Right"
                                 AutomationProperties.Name="Enter Quantity" />
                    </StackPanel>

                    <!-- Unit Price (Height 40) -->
                    <StackPanel Width="130" Margin="0,0,16,12">
                        <TextBlock Text="UNIT PRICE *"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="0,0,0,6" />
                        <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Unit price"
                                 x:Name="UnitPriceInput"
                                 Height="40"
                                 HorizontalAlignment="Stretch"
                                 HorizontalContentAlignment="Right"
                                 AutomationProperties.Name="Enter Unit Price" />
                    </StackPanel>

                    <!-- Discount % (Height 40) -->
                    <StackPanel Width="100" Margin="0,0,16,12">
                        <TextBlock Text="DISC %"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="0,0,0,6" />
                        <TextBox Text="{Binding DiscountPercentage, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="e.g. 0"
                                 Height="40"
                                 HorizontalAlignment="Stretch"
                                 HorizontalContentAlignment="Right"
                                 AutomationProperties.Name="Enter Discount Percentage" />
                    </StackPanel>

                    <!-- Add Item Button (Height 40) -->
                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,12">
                        <Button Command="{Binding AddItemCommand}"
                                Content="Add Item"
                                Style="{StaticResource BtnPrimaryStyle}"
                                Height="40"
                                Padding="22,0"
                                AutomationProperties.Name="Add item to sale" />
                    </StackPanel>
                </WrapPanel>
            </Border>

            <!-- ================================================================= -->
            <!-- ROW 3: CLEAN DATAGRID BOUND TO Items (.tbl styling)               -->
            <!-- ================================================================= -->
            <Border Grid.Row="4" Background="{StaticResource BlueLightBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Customer price memory" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" />
                        <TextBlock Text="{Binding PricingMessage}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,8,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Use previous" Command="{Binding UsePreviousPriceCommand}" Padding="12,7" Margin="0,0,6,0" ToolTip="Use this customer's most recent price for the selected product" />
                        <Button Content="Use default" Command="{Binding UseDefaultPriceCommand}" Padding="12,7" Margin="0,0,6,0" />
                        <Button Content="Enter new price" Command="{Binding EnterNewPriceCommand}" Click="EnterNewPrice_Click" Padding="12,7" />
                    </StackPanel>
                </Grid>
            </Border>

            <DataGrid Grid.Row="5"
                      ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      AutomationProperties.Name="Sales Line Items">
                <DataGrid.Columns>
                    <!-- Product Code -->
                    <DataGridTextColumn Header="CODE"
                                        Binding="{Binding Product.ProductCode}"
                                        Width="120" />

                    <!-- Product Name -->
                    <DataGridTextColumn Header="PRODUCT NAME"
                                        Binding="{Binding Product.ProductName}"
                                        Width="*" />

                    <!-- Quantity (Numeric Right Aligned) -->
                    <DataGridTextColumn Header="QTY"
                                        Binding="{Binding Quantity}"
                                        Width="90">
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="behaviors:NumericTextBoxBehavior.IsEnabled" Value="True" />
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="HorizontalContentAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Unit Price (Numeric Right Aligned) -->
                    <DataGridTextColumn Header="UNIT PRICE"
                                        Binding="{Binding UnitPrice, StringFormat=C}"
                                        Width="130">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="HorizontalContentAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Discount % (Numeric Right Aligned) -->
                    <DataGridTextColumn Header="DISC %"
                                        Binding="{Binding DiscountPercentage, StringFormat='{}{0:N0}%'}"
                                        Width="90">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="HorizontalContentAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Line Total (Numeric Right Aligned, Bold) -->
                    <DataGridTextColumn Header="LINE TOTAL"
                                        Binding="{Binding LineTotal, StringFormat=C}"
                                        Width="150">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="HorizontalContentAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Remove Action Button -->
                    <DataGridTemplateColumn Header="ACTIONS" Width="80">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Content="✕"
                                        Style="{StaticResource BtnDangerStyle}"
                                        Padding="8,3"
                                        MinHeight="26"
                                        FontSize="12"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        ToolTip="Remove item from invoice"
                                        AutomationProperties.Name="Remove item" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ================================================================= -->
            <!-- ROW 4: PROTOTYPE .inv-summary BLOCK & SAVE ACTIONS                 -->
            <!-- ================================================================= -->
            <Grid Grid.Row="6" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <!-- Left Spacer / Informational Hint -->
                    <ColumnDefinition Width="*" MinWidth="180" />
                    <!-- Right Summary Card -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Hint Note -->
                <Border Grid.Column="0"
                        VerticalAlignment="Bottom"
                        Background="{StaticResource BlueLightBrush}"
                        BorderBrush="#C9DEF0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,12"
                        Margin="0,0,24,0">
                    <StackPanel>
                        <TextBlock Text="Automatic Pricing Memory Active"
                                   FontWeight="Bold"
                                   FontSize="12.5"
                                   Foreground="{StaticResource BlueDarkBrush}" />
                        <TextBlock Text="Historical customer rates and wholesale tiers are automatically captured upon invoice confirmation."
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Right .inv-summary Card -->
                <Border Grid.Column="1"
                        Background="{StaticResource SurfaceSubtleBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20,16"
                        MinWidth="360">
                    <StackPanel>
                        <!-- Subtotal -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Subtotal"
                                       FontSize="13.5"
                                       Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SubTotal, StringFormat=C}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- Discount -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Discount Amount"
                                       FontSize="13.5"
                                       Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DiscountAmount, StringFormat=C}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource RedDarkBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- Divider -->
                        <Border Height="1"
                                Background="{StaticResource BorderBrush}"
                                Margin="0,4,0,10" />

                        <!-- Net Total (Large Green Text) -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Net Total"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource NavyBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding NetTotal, StringFormat=C}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GreenBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       AutomationProperties.Name="Net Total Amount" />
                        </Grid>

                        <!-- Paid Amount Input Row -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Paid Amount"
                                       FontSize="13.5"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Amount"
                                     Width="140"
                                     HorizontalAlignment="Right"
                                     HorizontalContentAlignment="Right"
                                     AutomationProperties.Name="Enter Paid Amount" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Received To" FontSize="13.5" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding PaymentSources}" SelectedItem="{Binding PaymentSource}" Width="140" Height="34" HorizontalAlignment="Right" AutomationProperties.Name="Choose where payment was received" />
                        </Grid>

                        <!-- Remaining Balance Due -->
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Balance Due"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource NavyBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RemainingBalance, StringFormat=C}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource RedBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- Save Invoice Button -->
                        <Button Command="{Binding SaveSaleCommand}"
                                Content="Save Invoice"
                                Style="{StaticResource BtnGreenStyle}"
                                Height="44"
                                FontSize="15"
                                FontWeight="Bold"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Save Sale Invoice" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
