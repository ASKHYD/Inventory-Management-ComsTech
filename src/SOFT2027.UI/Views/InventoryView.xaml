<UserControl x:Class="SOFT2027.UI.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:SOFT2027.UI.Behaviors"
             xmlns:vm="clr-namespace:SOFT2027.Presentation.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InventoryViewModel}"
             Background="Transparent" Loaded="View_Loaded">
    <Border Style="{StaticResource CardBorderStyle}" Padding="24" Margin="0,0,0,16">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Inventory" FontSize="22" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" />
                    <TextBlock Text="View current stock, spot low items, and record a reasoned stock adjustment." FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Command="{Binding LoadCommand}" Height="36" Padding="14,0" VerticalAlignment="Center" />
            </Grid>
            <DockPanel Grid.Row="1" Margin="0,0,0,14">
                <Border Background="{StaticResource AmberLightBrush}" CornerRadius="6" Padding="12,7" DockPanel.Dock="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Low or minimum stock items: " Foreground="{StaticResource AmberBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LowStockCount, Mode=OneWay}" Foreground="{StaticResource AmberBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource RedBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="12,0,0,0" VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive" />
            </DockPanel>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="0.95*" /></Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" AutoGenerateColumns="False"
                          CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" RowHeaderWidth="0"
                          AutomationProperties.Name="Current stock levels">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CODE" Binding="{Binding ProductCode}" Width="95" />
                        <DataGridTextColumn Header="PRODUCT" Binding="{Binding ProductName}" Width="*" />
                        <DataGridTextColumn Header="IN STOCK" Binding="{Binding CurrentStock, StringFormat=N2}" Width="95" />
                        <DataGridTextColumn Header="MINIMUM" Binding="{Binding MinimumStock, StringFormat=N2}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="No active products yet. Add a product in Master Data to see stock here."
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Products.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                </Grid>
                <Grid Grid.Column="1" Margin="16,0,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Adjust selected product" FontSize="16" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" />
                            <TextBlock Text="Use a positive quantity to add stock or a minus sign to remove it." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />
                            <TextBlock Text="QUANTITY CHANGE" FontSize="11" FontWeight="Bold" Margin="0,0,0,5" />
                            <TextBox Text="{Binding QuantityChange, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. 5 or -2" Height="38" behaviors:NumericTextBoxBehavior.IsEnabled="True" behaviors:NumericTextBoxBehavior.AllowNegative="True" HorizontalContentAlignment="Right" AutomationProperties.Name="Enter positive or negative stock change" />
                            <TextBlock Text="REASON" FontSize="11" FontWeight="Bold" Margin="0,12,0,5" />
                            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Tag="Why is stock changing?" Height="38" AutomationProperties.Name="Reason for stock adjustment" />
                            <Button Content="Save stock adjustment" Command="{Binding AdjustCommand}" Style="{StaticResource BtnPrimaryStyle}" Height="40" Margin="0,12,0,0" AutomationProperties.Name="Save stock adjustment" />
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Row="1" Text="Recent stock movements" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" />
                    <DataGrid Grid.Row="2" ItemsSource="{Binding MovementHistory}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" RowHeaderWidth="0" MinHeight="180" AutomationProperties.Name="Selected product stock movement history">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DATE" Binding="{Binding MovementDate, StringFormat=d}" Width="85" />
                            <DataGridTextColumn Header="TYPE" Binding="{Binding MovementType}" Width="95" />
                            <DataGridTextColumn Header="IN" Binding="{Binding QuantityIn, StringFormat=N2}" Width="70" />
                            <DataGridTextColumn Header="OUT" Binding="{Binding QuantityOut, StringFormat=N2}" Width="70" />
                            <DataGridTextColumn Header="BALANCE" Binding="{Binding BalanceQuantity, StringFormat=N2}" Width="85" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
