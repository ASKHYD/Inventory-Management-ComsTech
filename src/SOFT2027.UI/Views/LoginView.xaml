<UserControl x:Class="SOFT2027.UI.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SOFT2027.Presentation.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Branding & Features Pane (flex 1.15) -->
            <ColumnDefinition Width="1.15*" />
            <!-- Right Login Form Pane (flex 1) -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================================================================= -->
        <!-- LEFT PANE: Dark Navy Gradient & Feature Highlights               -->
        <!-- ================================================================= -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0D1B2A" Offset="0.0" />
                    <GradientStop Color="#13253A" Offset="0.6" />
                    <GradientStop Color="#17456E" Offset="1.2" />
                </LinearGradientBrush>
            </Border.Background>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel VerticalAlignment="Center" Margin="56,48">

                    <!-- ALI TRADERS Brand Badge -->
                    <Border Background="#FFFFFF"
                            CornerRadius="6"
                            Padding="20,10"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,22"
                            SnapsToDevicePixels="True">
                        <TextBlock Text="ALI TRADERS"
                                   Foreground="#000000"
                                   FontWeight="ExtraBold"
                                   FontSize="26"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <!-- Title -->
                    <TextBlock Text="FMCG Wholesale &amp; Distribution&#x0a;Management System"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,12" />

                    <!-- Subtitle -->
                    <TextBlock TextWrapping="Wrap"
                               FontSize="14"
                               Foreground="#B9C7D6"
                               MaxWidth="480"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,28">
                        <Bold Foreground="#FFFFFF">SOFT2027</Bold> — the desktop system that remembers your business: previous prices for every customer and supplier, stock, balances and history, all in one place.
                    </TextBlock>

                    <!-- 2x2 Feature Highlights Grid -->
                    <UniformGrid Columns="2" MaxWidth="520" HorizontalAlignment="Center">
                        <!-- Feature 1: Business Memory -->
                        <Border Background="#10FFFFFF"
                                BorderBrush="#25FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12"
                                Margin="0,0,10,12">
                            <StackPanel>
                                <TextBlock Text="Business Memory"
                                           FontWeight="Bold"
                                           FontSize="13.5"
                                           Foreground="#FFFFFF"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="Previous customer &amp; supplier prices appear automatically on every invoice."
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="#D7E1EC" />
                            </StackPanel>
                        </Border>

                        <!-- Feature 2: Offline Desktop -->
                        <Border Background="#10FFFFFF"
                                BorderBrush="#25FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Offline Desktop"
                                           FontWeight="Bold"
                                           FontSize="13.5"
                                           Foreground="#FFFFFF"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="Runs fully on this PC. No internet required for daily operations."
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="#D7E1EC" />
                            </StackPanel>
                        </Border>

                        <!-- Feature 3: Complete Control -->
                        <Border Background="#10FFFFFF"
                                BorderBrush="#25FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12"
                                Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Complete Control"
                                           FontWeight="Bold"
                                           FontSize="13.5"
                                           Foreground="#FFFFFF"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="Sales, purchases, stock, ledgers, cash, bank, expenses &amp; analytics."
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="#D7E1EC" />
                            </StackPanel>
                        </Border>

                        <!-- Feature 4: Safe & Audited -->
                        <Border Background="#10FFFFFF"
                                BorderBrush="#25FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12"
                                Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Safe &amp; Audited"
                                           FontWeight="Bold"
                                           FontSize="13.5"
                                           Foreground="#FFFFFF"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="Admin logins, immutable audit trail, and one-click backup &amp; restore."
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="#D7E1EC" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================================================================= -->
        <!-- RIGHT PANE: Centered White Login Card                             -->
        <!-- ================================================================= -->
        <Border Grid.Column="1"
                Background="{StaticResource BackgroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                    <!-- Login Card -->
                    <Border Background="#FFFFFF"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Width="390"
                            Padding="36,36"
                            Effect="{StaticResource CardDropShadow}"
                            SnapsToDevicePixels="True">
                        <StackPanel>

                            <!-- Heading -->
                            <TextBlock Text="{Binding LoginHeading}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource NavyBrush}"
                                       Margin="0,0,0,4" />

                            <TextBlock Text="{Binding LoginHint}"
                                       FontSize="12.5"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,20" />

                            <!-- Error Message Banner -->
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{StaticResource RedBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"
                                       AutomationProperties.LiveSetting="Assertive" />

                            <!-- Username Field -->
                            <TextBlock Text="Username *"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,0,0,6" />
                            <TextBox Text="{Binding LoginUsername, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Enter username"
                                     FontFamily="Segoe UI"
                                     FontSize="16"
                                     Foreground="Black"
                                     Padding="8,4"
                                     Height="40"
                                     Margin="0,0,0,16"
                                     AutomationProperties.Name="Username" />

                            <StackPanel Margin="0,0,0,14">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFirstRunSetup}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Your name *" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6" />
                                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Tag="Enter your name" FontFamily="Segoe UI" FontSize="16" Foreground="{StaticResource TextBrush}" Padding="10,4" Height="46" AutomationProperties.Name="Administrator full name" />
                            </StackPanel>

                            <!-- Password Field -->
                            <TextBlock Text="Password *"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,22">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <PasswordBox x:Name="LoginPasswordBox" Grid.Column="0"
                                             FontFamily="Segoe UI" FontSize="16" Foreground="{StaticResource TextBrush}"
                                             Background="#FFFFFF" BorderBrush="{StaticResource BorderDarkBrush}"
                                             BorderThickness="1" Padding="10,6" Height="40"
                                             AutomationProperties.Name="Password" />
                                <TextBox x:Name="LoginPasswordTextBox" Grid.Column="0"
                                         Text="{Binding LoginPassword, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Enter password"
                                         FontFamily="Segoe UI" FontSize="16" Foreground="{StaticResource TextBrush}"
                                         Padding="10,6" Height="40" Visibility="Collapsed" AutomationProperties.Name="Password" />
                                <Button x:Name="PasswordVisibilityToggle" Grid.Column="1" Content="Show" Width="58" Height="40" MinHeight="40"
                                        Margin="6,0,0,0" Padding="4,0" Click="TogglePasswordVisibility_Click"
                                        AutomationProperties.Name="Show or hide password" />
                            </Grid>

                            <StackPanel Margin="0,0,0,18">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFirstRunSetup}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Confirm password *" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6" />
                                <PasswordBox x:Name="ConfirmPasswordBox" FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource TextBrush}" Background="#FFFFFF" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" Padding="10,6" Height="40" AutomationProperties.Name="Confirm administrator password" />
                            </StackPanel>

                            <!-- Sign In Submit Button -->
                            <Button Command="{Binding LoginCommand}"
                                    Style="{StaticResource BtnPrimaryStyle}"
                                    IsDefault="True"
                                    Background="#1F4E79"
                                    Foreground="#FFFFFF"
                                    BorderBrush="#16395A"
                                    BorderThickness="1"
                                    Height="42"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Stretch"
                                    Cursor="Hand"
                                    AutomationProperties.Name="Sign In">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ButtonBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              RecognizesAccessKey="True" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2A6096" />
                                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#1F4E79" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="#16395A" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="{Binding LoginButtonText}"
                                           Foreground="#FFFFFF"
                                           FontSize="14"
                                           FontWeight="Bold" />
                            </Button>

                            <!-- Credentials Hint Badge -->
                            <Border Background="{StaticResource BlueLightBrush}"
                                    BorderBrush="#C9DEF0"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,10"
                                    Margin="0,18,0,0">
                                <TextBlock FontSize="12"
                                           Foreground="{StaticResource BlueDarkBrush}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center">
                                    Offline Access — Enter authorized system credentials to sign in
                                </TextBlock>
                            </Border>

                            <!-- Footer Attribution -->
                            <StackPanel Margin="0,24,0,0" HorizontalAlignment="Center">
                                <TextBlock Text="Offline Desktop Application"
                                           FontSize="11.5"
                                           Foreground="{StaticResource FaintBrush}"
                                           TextAlignment="Center" />
                                <TextBlock TextAlignment="Center"
                                           FontSize="11.5"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,3,0,0">
                                    <Run Text="Developed by " />
                                    <Run Text="COMSTECH.Solutions" FontWeight="Bold" />
                                </TextBlock>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
