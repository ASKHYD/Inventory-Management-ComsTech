<UserControl x:Class="SOFT2027.UI.Views.PurchaseEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:SOFT2027.UI.Behaviors"
             xmlns:vm="clr-namespace:SOFT2027.Presentation.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PurchaseEntryViewModel}"
             Background="Transparent"
             PreviewKeyDown="PurchaseEntryView_PreviewKeyDown"
             Loaded="View_Loaded">
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="P" Modifiers="Alt" Command="{Binding UsePreviousPriceCommand}" />
        <KeyBinding Key="D" Modifiers="Alt" Command="{Binding UseDefaultPriceCommand}" />
        <KeyBinding Key="N" Modifiers="Alt" Command="{Binding EnterNewPriceCommand}" />
    </UserControl.InputBindings>
    <Border Style="{StaticResource PageContentCardStyle}" Margin="{StaticResource Layout_Margin_0_0_0_16}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="{StaticResource Layout_Margin_0_0_0_16}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="New Purchase Bill" FontSize="{StaticResource TypePageTitle}" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" />
                    <TextBlock Text="Choose a supplier and products, check the saved price memory, then save the bill." FontSize="{StaticResource TypeBody}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="{StaticResource Layout_Margin_0_4_0_0}" />
                </StackPanel>
                <Button Grid.Column="1" Content="New Bill [F12]" Command="{Binding NewBillCommand}" Style="{StaticResource BtnStyle}" Height="32" Padding="12,0" VerticalAlignment="Center" ToolTip="Clear current bill and start new purchase" />
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="{StaticResource Layout_BorderThickness_1}" CornerRadius="{StaticResource Layout_CornerRadius_8}" Padding="{StaticResource Layout_Padding_10}" Margin="{StaticResource Layout_Margin_0_0_0_12}">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="Saved bill" VerticalAlignment="Center" FontWeight="SemiBold" Margin="{StaticResource Layout_Margin_0_0_10_0}" />
                    <ComboBox ItemsSource="{Binding SavedBills}" SelectedItem="{Binding SelectedSavedBill}" DisplayMemberPath="DisplayText" Width="{StaticResource Layout_Width_330}" Height="{StaticResource ControlHeight}" VerticalContentAlignment="Center" Tag="Recent saved purchase bills" AutomationProperties.Name="Choose a saved purchase bill from transaction history" />
                    <TextBox Text="{Binding DocumentLookupNumber, UpdateSourceTrigger=PropertyChanged}" Width="{StaticResource Layout_Width_210}" Height="{StaticResource ControlHeight}" VerticalContentAlignment="Center" Tag="Enter bill number" AutomationProperties.Name="Saved purchase bill number" />
                    <Button Content="Preview / Print" Click="PreviewBill_Click" Margin="{StaticResource Layout_Margin_8_0_0_0}" Padding="{StaticResource Layout_Padding_14_5}" AutomationProperties.Name="Find and preview saved purchase bill" />
                    <Button Content="Preview latest saved" Click="PreviewLatestBill_Click" Margin="{StaticResource Layout_Margin_8_0_0_0}" Padding="{StaticResource Layout_Padding_14_5}" AutomationProperties.Name="Preview latest saved purchase bill" />
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="{StaticResource Layout_BorderThickness_1}" CornerRadius="{StaticResource Layout_CornerRadius_8}" Padding="{StaticResource Layout_Padding_16}" Margin="{StaticResource Layout_Margin_0_0_0_12}">
                <WrapPanel Orientation="Horizontal">
                    <StackPanel Width="{StaticResource Layout_Width_195}" Margin="{StaticResource Layout_Margin_0_0_8_10}">
                        <TextBlock Text="SUPPLIER [F1 / Ctrl+1]" FontSize="{StaticResource TypeBody}" FontWeight="Bold" Margin="{StaticResource Layout_Margin_0_0_0_5}" />
                        <ComboBox x:Name="SupplierSelector" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="SupplierName" Tag="Type or choose supplier [F1 / Ctrl+1]" IsEditable="True" IsTextSearchEnabled="True" Height="{StaticResource ControlHeight}" AutomationProperties.Name="Select supplier" />
                    </StackPanel>
                    <StackPanel Width="{StaticResource Layout_Width_205}" Margin="{StaticResource Layout_Margin_0_0_8_10}">
                        <TextBlock Text="PRODUCT [F2 / Ctrl+2]" FontSize="{StaticResource TypeBody}" FontWeight="Bold" Margin="{StaticResource Layout_Margin_0_0_0_5}" />
                        <ComboBox x:Name="ProductSelector" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" DisplayMemberPath="ProductName" Tag="Type or choose product [F2 / Ctrl+2]" IsEditable="True" IsTextSearchEnabled="True" Height="{StaticResource ControlHeight}" AutomationProperties.Name="Select product" />
                    </StackPanel>
                    <StackPanel Width="{StaticResource Layout_Width_100}" Margin="{StaticResource Layout_Margin_0_0_8_10}">
                        <TextBlock Text="QUANTITY" FontSize="{StaticResource TypeBody}" FontWeight="Bold" Margin="{StaticResource Layout_Margin_0_0_0_5}" />
                        <TextBox x:Name="QuantityInput" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. 1" Height="{StaticResource ControlHeight}" behaviors:NumericTextBoxBehavior.IsEnabled="True" Style="{StaticResource NumericTextBoxStyle}" AutomationProperties.Name="Enter quantity" />
                    </StackPanel>
                    <StackPanel Width="{StaticResource Layout_Width_125}" Margin="{StaticResource Layout_Margin_0_0_8_10}">
                        <TextBlock Text="UNIT PRICE" FontSize="{StaticResource TypeBody}" FontWeight="Bold" Margin="{StaticResource Layout_Margin_0_0_0_5}" />
                        <TextBox x:Name="UnitPriceInput" Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Tag="Unit price" Height="{StaticResource ControlHeight}" Style="{StaticResource NumericTextBoxStyle}" AutomationProperties.Name="Enter purchase price" />
                    </StackPanel>
                    <StackPanel Width="{StaticResource Layout_Width_105}" Margin="{StaticResource Layout_Margin_0_0_8_10}">
                        <TextBlock Text="DISCOUNT %" FontSize="{StaticResource TypeBody}" FontWeight="Bold" Margin="{StaticResource Layout_Margin_0_0_0_5}" />
                        <TextBox x:Name="DiscountInput" Text="{Binding DiscountPercentage, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. 0" Height="{StaticResource ControlHeight}" Style="{StaticResource NumericTextBoxStyle}" AutomationProperties.Name="Enter line discount percentage" />
                    </StackPanel>
                    <Button x:Name="AddItemButton" Content="Add product [Enter]" Command="{Binding AddItemCommand}" Style="{StaticResource BtnPrimaryStyle}" VerticalAlignment="Bottom" Height="{StaticResource ButtonHeight}" Padding="{StaticResource Layout_Padding_12_0}" Margin="{StaticResource Layout_Margin_0_0_0_10}" AutomationProperties.Name="Add product to purchase" />
                </WrapPanel>
            </Border>

            <DockPanel Grid.Row="3" Margin="{StaticResource Layout_Margin_0_0_0_12}" LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="{StaticResource Layout_Margin_0_0_12_0}">
                    <Button Content="Use previous rate" Command="{Binding UsePreviousPriceCommand}" Padding="{StaticResource Layout_Padding_12_7}" Margin="{StaticResource Layout_Margin_0_0_6_0}" ToolTip="Use this supplier's most recent rate for the selected product" />
                    <Button Content="Use product default" Command="{Binding UseDefaultPriceCommand}" Padding="{StaticResource Layout_Padding_12_7}" Margin="{StaticResource Layout_Margin_0_0_6_0}" />
                    <Button Content="Enter a new rate" Command="{Binding EnterNewPriceCommand}" Click="EnterNewPrice_Click" Padding="{StaticResource Layout_Padding_12_7}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding PricingMessage}" FontSize="{StaticResource TypeSmall}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorMessage, Converter={StaticResource StatusMessageConverter}, ConverterParameter=Error}" FontSize="{StaticResource TypeSmall}" Foreground="{Binding ErrorMessage, Converter={StaticResource StatusMessageConverter}, ConverterParameter=Color}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <DataGrid Grid.Row="4" ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False"
                      HeadersVisibility="Column" MinHeight="100"
                      MaxHeight="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualHeight, Converter={StaticResource ViewportRatioConverter}, ConverterParameter=0.45}"
                      CanUserResizeColumns="True" AutomationProperties.Name="Purchase items">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CODE" Binding="{Binding Product.ProductCode}" IsReadOnly="True" MinWidth="130" Width="140" />
                    <DataGridTextColumn Header="PRODUCT" Binding="{Binding Product.ProductName}" IsReadOnly="True" Width="*" MinWidth="160" />
                    <DataGridTextColumn Header="QTY" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="85">
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="behaviors:NumericTextBoxBehavior.IsEnabled" Value="True" />
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SharedDataGridColumnHeaderStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="UNIT PRICE (PKR)" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat={StaticResource NumberStringFormat}}" Width="140">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SharedDataGridColumnHeaderStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="DISC %" Binding="{Binding DiscountPercentage, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N0}%'}" Width="85">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SharedDataGridColumnHeaderStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="LINE TOTAL (PKR)" Binding="{Binding LineTotal, StringFormat={StaticResource NumberStringFormat}}" IsReadOnly="True" Width="140">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SharedDataGridColumnHeaderStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="ACTION" Width="100">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SharedDataGridColumnHeaderStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Remove" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="8,2" HorizontalAlignment="Center" AutomationProperties.Name="Remove product from purchase" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="5" Margin="{StaticResource Layout_Margin_0_16_0_0}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Product price memory is saved when this bill is posted." FontSize="{StaticResource TypeSmall}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorMessage, Converter={StaticResource StatusMessageConverter}, ConverterParameter=Error}" Foreground="{Binding ErrorMessage, Converter={StaticResource StatusMessageConverter}, ConverterParameter=Color}" FontSize="{StaticResource TypeSmall}" FontWeight="SemiBold" Margin="{StaticResource Layout_Margin_0_4_0_0}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                    <TextBlock Text="{Binding StatusAnnouncement, Converter={StaticResource StatusMessageConverter}}" Foreground="{Binding StatusAnnouncement, Converter={StaticResource StatusMessageConverter}, ConverterParameter=Color}" FontSize="{StaticResource TypeSmall}" Margin="{StaticResource Layout_Margin_0_4_0_0}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <StackPanel Grid.Column="1" Width="{StaticResource Layout_Width_300}" Background="{StaticResource SurfaceSubtleBrush}" Margin="{StaticResource Layout_Margin_16_0_0_0}">
                    <Grid Margin="{StaticResource Layout_Margin_12_12_12_5}"><TextBlock Text="Subtotal" /><TextBlock Text="{Binding SubTotal, StringFormat={StaticResource CurrencyStringFormat}}" HorizontalAlignment="Right" /></Grid>
                    <Grid Margin="{StaticResource Layout_Margin_12_0_12_5}"><TextBlock Text="Discount" /><TextBlock Text="{Binding DiscountAmount, StringFormat={StaticResource CurrencyStringFormat}}" HorizontalAlignment="Right" /></Grid>
                    <Grid Margin="{StaticResource Layout_Margin_12_0_12_5}"><TextBlock Text="Bill total" FontWeight="Bold" FontSize="{StaticResource TypeEmphasis}" /><TextBlock Text="{Binding NetTotal, StringFormat={StaticResource CurrencyStringFormat}}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="{StaticResource TypeEmphasis}" /></Grid>
                    <Grid Margin="{StaticResource Layout_Margin_12_0_12_5}"><TextBlock Text="Pay from" VerticalAlignment="Center" /><ComboBox ItemsSource="{Binding PaymentSources}" SelectedItem="{Binding PaymentSource}" Width="{StaticResource Layout_Width_120}" Height="{StaticResource ControlHeight}" HorizontalAlignment="Right" AutomationProperties.Name="Choose cash or bank for this payment" /></Grid>
                    <Grid Margin="{StaticResource Layout_Margin_12_0_12_5}"><TextBlock Text="Paid now" VerticalAlignment="Center" /><TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}" Tag="Amount" Width="{StaticResource Layout_Width_120}" Style="{StaticResource NumericTextBoxStyle}" HorizontalAlignment="Right" /></Grid>
                    <Grid Margin="{StaticResource Layout_Margin_12_0_12_12}"><TextBlock Text="Supplier balance" FontWeight="SemiBold" /><TextBlock Text="{Binding RemainingBalance, StringFormat={StaticResource CurrencyStringFormat}}" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid>
                    <Button Content="Save Purchase [Ctrl+S]" Command="{Binding SaveCommand}" Style="{StaticResource BtnPrimaryStyle}" Height="{StaticResource ButtonHeight}" Margin="12,0,12,8" FontWeight="Bold" AutomationProperties.Name="Save purchase bill" />
                    <Button Content="Save &amp; Print [F4 / Ctrl+S]" Click="SaveAndPrintBill_Click" Style="{StaticResource BtnStyle}" Height="{StaticResource ButtonHeight}" Margin="12,0,12,8" FontWeight="Bold" AutomationProperties.Name="Save and print purchase bill" />
                    <Button Content="New Bill [F12 / Ctrl+N]" Command="{Binding NewBillCommand}" Style="{StaticResource BtnStyle}" Height="{StaticResource ButtonHeight}" Margin="{StaticResource Layout_Margin_12_0_12_12}" FontWeight="Bold" AutomationProperties.Name="Clear and start new purchase bill" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
