<Window x:Class="SOFT2027.UI.Views.AppTourWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SOFT2027 getting started" Height="430" Width="640"
        MinHeight="390" MinWidth="560" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="A quick tour of SOFT2027" FontSize="22" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" />
            <TextBlock Text="Simple steps to get comfortable with your business software." FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="24">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding ProgressText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}" Margin="0,0,0,12" />
                <TextBlock Text="{Binding StepTitle}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding StepBody}" FontSize="15" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="23" />
            </StackPanel>
        </Border>
        <DockPanel Grid.Row="2" Margin="0,18,0,0" LastChildFill="False">
            <Button Content="Skip tour" Click="Skip_Click" Padding="14,8" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Back" Click="Back_Click" Padding="18,8" Margin="0,0,8,0" IsEnabled="{Binding CanGoBack}" />
                <Button Content="{Binding NextButtonText}" Click="Next_Click" Padding="18,8" Style="{StaticResource BtnPrimaryStyle}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
