<Window x:Class="SOFT2027.UI.Views.AppTourWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SOFT2027 getting started" Height="{StaticResource Layout_Height_430}" Width="{StaticResource Layout_Width_640}"
        MinHeight="{StaticResource Layout_MinHeight_390}" MinWidth="{StaticResource Layout_MinWidth_560}" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None" Background="{StaticResource BackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" CornerRadius="{StaticResource Layout_CornerRadius_8}" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid Margin="{StaticResource Layout_Margin_28}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" shell:WindowChrome.IsHitTestVisibleInChrome="True" MouseLeftButtonDown="Caption_MouseLeftButtonDown">
            <TextBlock Text="SOFT2027" FontSize="{StaticResource TypeSmall}" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <Button Content="×" FontFamily="Segoe UI Symbol" FontSize="15" Width="46" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}"
                    Click="CloseWindow_Click" ToolTip="Close" AutomationProperties.Name="Close">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CloseBorder" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CloseBorder" Property="Background" Value="#E81123" /><Setter Property="Foreground" Value="White" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
        <StackPanel Grid.Row="1" Margin="{StaticResource Layout_Margin_0_0_0_18}">
            <TextBlock Text="A quick tour of SOFT2027" FontSize="{StaticResource TypePageTitle}" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" />
            <TextBlock Text="Simple steps to get comfortable with your business software." FontSize="{StaticResource TypeBody}" Foreground="{StaticResource MutedBrush}" Margin="{StaticResource Layout_Margin_0_4_0_0}" />
        </StackPanel>
        <Border Grid.Row="2" Background="{StaticResource SurfaceWhiteBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="{StaticResource Layout_BorderThickness_1}" CornerRadius="{StaticResource Layout_CornerRadius_10}" Padding="{StaticResource Layout_Padding_24}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding ProgressText}" FontSize="{StaticResource TypeSmall}" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}" Margin="{StaticResource Layout_Margin_0_0_0_12}" />
                <TextBlock Text="{Binding StepTitle}" FontSize="{StaticResource TypeSectionTitle}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding StepBody}" FontSize="{StaticResource TypeBody}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="{StaticResource Layout_Margin_0_12_0_0}" LineHeight="{StaticResource Layout_LineHeight_23}" />
            </StackPanel>
        </Border>
        <DockPanel Grid.Row="3" Margin="{StaticResource Layout_Margin_0_18_0_0}" LastChildFill="False">
            <Button Content="Skip tour" Click="Skip_Click" Padding="{StaticResource Layout_Padding_14_8}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Back" Click="Back_Click" Padding="{StaticResource Layout_Padding_18_8}" Margin="{StaticResource Layout_Margin_0_0_8_0}" IsEnabled="{Binding CanGoBack}" />
                <Button Content="{Binding NextButtonText}" Click="Next_Click" Padding="{StaticResource Layout_Padding_18_8}" Style="{StaticResource BtnPrimaryStyle}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
