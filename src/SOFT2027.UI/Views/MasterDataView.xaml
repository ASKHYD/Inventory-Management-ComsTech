<UserControl x:Class="SOFT2027.UI.Views.MasterDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SOFT2027.Presentation.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MasterDataViewModel}"
             Background="Transparent">
    <Border Style="{StaticResource CardBorderStyle}" Padding="24" Margin="0,0,0,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" />
                <TextBlock Text="{Binding HelpText}" FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>

            <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,0,0,12">
                <Grid Width="260" Height="38">
                    <TextBox x:Name="RecordsSearchBox" Height="38" VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search by code, name, contact details, or status"
                             AutomationProperties.Name="Search records" />
                    <TextBlock Text="Search by name or code..." Foreground="{StaticResource MutedBrush}"
                               Margin="13,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=RecordsSearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button Content="Refresh" Command="{Binding LoadCommand}" Margin="8,0,0,0" Padding="14,0" Height="38" />
                <Button Content="{Binding AddLabel}" Command="{Binding AddCommand}" Style="{StaticResource BtnPrimaryStyle}" Margin="8,0,0,0" Padding="16,0" Height="38" />
                <Button Content="Save Changes" Command="{Binding SaveCommand}" Style="{StaticResource BtnGreenStyle}" Margin="8,0,0,0" Padding="16,0" Height="38"
                        AutomationProperties.Name="Save changes" />
            </DockPanel>

            <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="{StaticResource RedBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"
                       AutomationProperties.LiveSetting="Assertive" />

            <DataGrid x:Name="RecordsGrid" Grid.Row="3" ItemsSource="{Binding FilteredRecords}"
                      SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                      AutoGenerateColumns="True" AutoGeneratingColumn="RecordsGrid_AutoGeneratingColumn"
                      CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      HeadersVisibility="Column" RowHeaderWidth="0"
                      GridLinesVisibility="Horizontal" MinHeight="260"
                      AutomationProperties.Name="Master data records" />

            <DockPanel Grid.Row="4" Margin="0,14,0,0" LastChildFill="False">
                <TextBlock Text="Changes are saved to this computer. Inactive records remain available in transaction history."
                           Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Content="{Binding StatusActionLabel}" Command="{Binding ToggleStatusCommand}" Margin="16,0,0,0" Padding="12,0" Height="36"
                        ToolTip="Select one row, change its status, then save changes." />
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
