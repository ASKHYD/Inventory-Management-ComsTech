<UserControl x:Class="SOFT2027.UI.Views.LookupManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">
    <Grid>
        <Border Style="{StaticResource PageContentCardStyle}" Margin="{StaticResource Layout_Margin_0_0_0_16}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="{StaticResource Layout_Margin_0_0_0_18}">
                <TextBlock Text="Categories, Brands &amp; Units" FontSize="{StaticResource TypePageTitle}" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" />
                <TextBlock Text="Maintain the lists used to organize products. Items assigned to products must be unassigned before deletion." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="{StaticResource Layout_Margin_0_4_0_0}" />
            </StackPanel>

            <DockPanel Grid.Row="1" LastChildFill="False" Margin="{StaticResource Layout_Margin_0_0_0_12}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="LIST" VerticalAlignment="Center" FontWeight="Bold" Margin="{StaticResource Layout_Margin_0_0_10_0}" Foreground="{StaticResource NavyBrush}" />
                    <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" Width="220" Height="{StaticResource ControlHeight}" VerticalContentAlignment="Center" AutomationProperties.Name="Select list type" />
                </StackPanel>
                <Button Command="{Binding LoadCommand}" Margin="{StaticResource Layout_Margin_12_0_0_0}" Padding="{StaticResource Layout_Padding_14_0}" Height="{StaticResource ButtonHeight}"
                        ToolTip="Refresh list" AutomationProperties.Name="Refresh list">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource SpinningIndicatorStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <Path Data="{StaticResource IconRefreshGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="14" Height="14" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding AddCommand}" Style="{StaticResource BtnPrimaryStyle}" Margin="{StaticResource Layout_Margin_8_0_0_0}" Padding="{StaticResource Layout_Padding_16_0}" Height="{StaticResource ButtonHeight}"
                        ToolTip="Add a new entry" AutomationProperties.Name="Add entry">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconPlusGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="Add Item" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding SaveCommand}" Style="{StaticResource BtnPrimaryStyle}" Margin="{StaticResource Layout_Margin_8_0_0_0}" Padding="{StaticResource Layout_Padding_16_0}" Height="{StaticResource ButtonHeight}"
                        ToolTip="Save changes" AutomationProperties.Name="Save changes">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconCheckGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" Width="14" Height="14" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="Save Changes" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>

            <!-- Status and Error Notification Banners -->
            <StackPanel Grid.Row="2" Margin="{StaticResource Layout_Margin_0_0_0_12}">
                <!-- Success Announcement Banner -->
                <Border Background="{StaticResource GreenLightBrush}" BorderBrush="{StaticResource GreenBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusAnnouncement, Converter={StaticResource StatusMessageConverter}}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasErrors}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="✓" FontWeight="Bold" Foreground="{StaticResource GreenBrush}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusAnnouncement}" Foreground="{StaticResource GreenDarkBrush}" FontWeight="SemiBold"
                                   FontSize="{StaticResource TypeBody}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!-- Error Banner -->
                <Border Background="{StaticResource RedLightBrush}" BorderBrush="{StaticResource RedBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="⚠" FontWeight="Bold" Foreground="{StaticResource RedBrush}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource RedDarkBrush}" FontWeight="SemiBold"
                                   FontSize="{StaticResource TypeBody}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Row="3">
                <DataGrid x:Name="LookupGrid" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" MinHeight="{StaticResource Layout_MinHeight_260}"
                          AutomationProperties.Name="Product categories brands or units">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Delete Selected Item" Click="DeleteSelected_Click">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource IconTrashGeometry}" Stroke="{StaticResource RedBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MinWidth="260" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Loading State with Active Spinner -->
                <Border x:Name="LoadingStateBorder" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource SurfaceWhiteBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20,12" Effect="{StaticResource CardDropShadow}"
                        IsHitTestVisible="False" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar Style="{StaticResource SpinningIndicatorStyle}" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="LoadStateText" Foreground="{StaticResource NavyBrush}" FontSize="{StaticResource TypeBody}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Text="Loading list…" />
                    </StackPanel>
                </Border>

                <!-- Empty State Overlay (No items yet) -->
                <Border x:Name="EmptyStateBorder" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource SurfaceWhiteBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="24,16" Effect="{StaticResource CardDropShadow}"
                        IsHitTestVisible="False" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconTagGeometry}" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5"
                              Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="EmptyStateText" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource TypeBody}"
                                   VerticalAlignment="Center" Text="No items yet." />
                    </StackPanel>
                </Border>
            </Grid>
            <DockPanel Grid.Row="4" Margin="{StaticResource Layout_Margin_0_14_0_0}" LastChildFill="False">
                <Button Content="Delete Selected" Click="DeleteSelected_Click" Padding="{StaticResource Layout_Padding_14_0}" Height="{StaticResource ButtonHeight}"
                        ToolTip="Delete selected item if unused" />
            </DockPanel>
        </Grid>
    </Border>

        <!-- ========================================================================= -->
        <!-- MODAL ADD ITEM DIALOG (Category, Brand, Unit)                              -->
        <!-- ========================================================================= -->
        <Grid Panel.ZIndex="1000">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAddFormOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- Dimmed Backdrop -->
                <Border Background="#88000000" />

                <!-- Modal Dialog Box (MaxHeight 85vh for 1366x768 screens) -->
                <Border Width="480" MaxHeight="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualHeight, Converter={StaticResource ViewportRatioConverter}, ConverterParameter=0.85}"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="{StaticResource SurfaceWhiteBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12" Effect="{StaticResource PopupDropShadow}"
                        Padding="28,24" SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,16">
                            <Button DockPanel.Dock="Right" Command="{Binding CancelAddCommand}"
                                    Content="×" FontFamily="Segoe UI Symbol" FontSize="18"
                                    Width="36" Height="36" MinHeight="0" Padding="0"
                                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}"
                                    ToolTip="Close form without saving" AutomationProperties.Name="Cancel add item">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BtnStyle}">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FDECEC" />
                                                <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding AddFormTitle}" FontSize="{StaticResource TypeSectionTitle}" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" />
                                <TextBlock Text="Enter the name for this master-data record and save." FontSize="{StaticResource TypeSmall}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Error Banner -->
                        <Border Grid.Row="1" Background="{StaticResource RedLightBrush}" BorderBrush="{StaticResource RedBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,14">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="⚠" FontWeight="Bold" Foreground="{StaticResource RedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource RedDarkBrush}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <!-- Field Input -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,20">
                            <TextBlock Text="Item Name *" FontWeight="SemiBold" FontSize="{StaticResource TypeSmall}" Margin="0,0,0,6" />
                            <TextBox x:Name="NewItemNameBox" Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}" Height="{StaticResource ControlHeight}"
                                     FontSize="{StaticResource TypeBody}" VerticalContentAlignment="Center" AutomationProperties.Name="New Item Name" />
                        </StackPanel>

                        <!-- Actions -->
                        <DockPanel Grid.Row="3" LastChildFill="False">
                            <Button DockPanel.Dock="Left" Content="Cancel" Command="{Binding CancelAddCommand}"
                                    IsCancel="True"
                                    Padding="{StaticResource Layout_Padding_18_8}" Height="{StaticResource ButtonHeight}" />
                            <Button DockPanel.Dock="Right" Command="{Binding SaveNewItemCommand}"
                                    IsDefault="True"
                                    Style="{StaticResource BtnPrimaryStyle}" Padding="{StaticResource Layout_Padding_24_8}" Height="{StaticResource ButtonHeight}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ProgressBar Width="16" Height="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource SpinningIndicatorStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                    <TextBlock Text="{Binding SaveNewActionLabel}" VerticalAlignment="Center" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
</UserControl>
