<Window x:Class="SOFT2027.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SOFT2027.Presentation.ViewModels"
        xmlns:views="clr-namespace:SOFT2027.UI.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="SOFT2027 — Ali Traders FMCG Wholesale &amp; Distribution"
        Height="720" Width="1280"
        MinHeight="560" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        PreviewMouseWheel="MainWindow_PreviewMouseWheel"
        WindowStyle="None"
        Background="{StaticResource BackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="68" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TopbarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource BtnStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F1F5F9" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#E2E8F0" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F5F8FC" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#B7CBE0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TopbarProfileButtonStyle" TargetType="Button" BasedOn="{StaticResource TopbarIconButtonStyle}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F1F5F9" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#E2E8F0" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F7FAFD" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#D5E1ED" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowControlButtonStyle" TargetType="Button" BasedOn="{StaticResource BtnStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="5">
                                <ContentPresenter x:Name="WindowButtonContentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <Border x:Name="FocusRing" Background="Transparent" BorderBrush="Transparent"
                                    BorderThickness="1" CornerRadius="5" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                    <Setter Property="Foreground" Value="#172B4D" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#D6E5F2" />
                    <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FEF2F2" />
                    <Setter Property="Foreground" Value="#B42318" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B91C1C" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WindowMaximizeButtonStyle" TargetType="Button">
            <Style.BasedOn>
                <StaticResource ResourceKey="WindowControlButtonStyle" />
            </Style.BasedOn>
            <Setter Property="Content" Value="▢" />
            <Setter Property="ToolTip" Value="Maximize Window" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                    <Setter Property="Content" Value="❐" />
                    <Setter Property="ToolTip" Value="Restore Window" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- ViewModel to View DataTemplates -->
        <DataTemplate DataType="{x:Type vm:SalesEntryViewModel}">
            <views:SalesEntryView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PurchaseEntryViewModel}">
            <views:PurchaseEntryView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ReportsDashboardViewModel}">
            <views:ReportsDashboardView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MasterDataViewModel}">
            <views:MasterDataView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:FinancialEntryViewModel}">
            <views:FinancialEntryView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CashBankViewModel}">
            <views:CashBankView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BackupViewModel}">
            <views:BackupView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ReturnEntryViewModel}">
            <views:ReturnEntryView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LedgerViewModel}">
            <views:LedgerView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AdministrationViewModel}">
            <views:AdministrationView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LookupManagementViewModel}">
            <views:LookupManagementView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- ================================================================= -->
        <!-- APP SHELL: Visible when IsAuthenticated == True                   -->
        <!-- ================================================================= -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <!-- Exactly 250px Fixed Left Sidebar -->
                <ColumnDefinition Width="250" />
                <!-- Main Content Area -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR (Strictly 250px, Navy Gradient, Zero Negative Margins) -->
            <Border Grid.Column="0"
                    Margin="0"
                    HorizontalAlignment="Stretch"
                    Background="{StaticResource SidebarGradientBrush}"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Brand Header -->
                        <RowDefinition Height="*" />    <!-- Navigation Menu Items -->
                        <RowDefinition Height="Auto" /> <!-- Footer Attribution & Status -->
                    </Grid.RowDefinitions>

                    <!-- TOP BRAND CARD -->
                    <Border Grid.Row="0"
                            Padding="16,18,16,14"
                            BorderBrush="{StaticResource SidebarBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <!-- White "ALI TRADERS" Badge -->
                            <Border Background="#FFFFFF"
                                    CornerRadius="5"
                                    Padding="8,8"
                                    Margin="0,0,0,8"
                                    SnapsToDevicePixels="True">
                                <TextBlock Text="ALI TRADERS"
                                           Foreground="#000000"
                                           FontWeight="ExtraBold"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />
                            </Border>
                            <!-- Subtitle Tag -->
                            <TextBlock Text="FMCG Wholesale &amp; Distribution"
                                       Foreground="{StaticResource SidebarTagBrush}"
                                       FontSize="11.5"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- NAVIGATION MENU -->
                    <ScrollViewer x:Name="NavigationScrollViewer" Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <StackPanel Margin="10,12,10,16">

                            <!-- Nav Group: OPERATIONS -->
                            <TextBlock Text="OPERATIONS"
                                       Foreground="{StaticResource SidebarNavGroupBrush}"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       Padding="10,12,10,6" />

                            <!-- Nav Item: Sales Entry -->
                            <Button Style="{StaticResource SidebarNavItemStyle}"
                                    Command="{Binding NavigateToSalesCommand}"
                                    AutomationProperties.Name="Navigate to Sales Entry"
                                    AutomationProperties.HelpText="Open point-of-sale invoice entry">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconSaleGeometry}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6"
                                          Width="17" Height="17"
                                          Margin="0,0,10,0"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Sales Entry"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               FontSize="13.5"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarNavItemStyle}"
                                    Command="{Binding NavigateToPurchasesCommand}"
                                    AutomationProperties.Name="Create a purchase bill">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconSaleGeometry}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6" Width="17" Height="17" Margin="0,0,10,0" Stretch="Uniform" />
                                    <TextBlock Text="Purchase Entry" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="13.5" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarNavItemStyle}" Command="{Binding NavigateToSalesReturnsCommand}" AutomationProperties.Name="Record a customer sales return">
                                <TextBlock Text="Sales Returns" FontSize="13.5" />
                            </Button>
                            <Button Style="{StaticResource SidebarNavItemStyle}" Command="{Binding NavigateToPurchaseReturnsCommand}" AutomationProperties.Name="Record a supplier purchase return">
                                <TextBlock Text="Purchase Returns" FontSize="13.5" />
                            </Button>

                            <TextBlock Text="INVENTORY" Foreground="{StaticResource SidebarNavGroupBrush}" FontSize="10.5" FontWeight="Bold" Padding="10,16,10,6" />
                            <Button Style="{StaticResource SidebarNavItemStyle}" Command="{Binding NavigateToInventoryCommand}" AutomationProperties.Name="View current stock and make adjustments">
                                <TextBlock Text="Current Stock &amp; Movements" FontSize="13.5" />
                            </Button>

                            <!-- Nav Group: MASTER DATA -->
                            <TextBlock Text="MASTER DATA"
                                       Foreground="{StaticResource SidebarNavGroupBrush}"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       Padding="10,16,10,6" />

                            <Button Style="{StaticResource SidebarNavItemStyle}"
                                    Command="{Binding NavigateToProductsCommand}"
                                    AutomationProperties.Name="Manage products">
                                <TextBlock Text="Products" FontSize="13.5" />
                            </Button>
                            <Button Style="{StaticResource SidebarNavItemStyle}"
                                    Command="{Binding NavigateToCustomersCommand}"
                                    AutomationProperties.Name="Manage customers">
                                <TextBlock Text="Customers" FontSize="13.5" />
                            </Button>
                            <Button Style="{StaticResource SidebarNavItemStyle}"
                                    Command="{Binding NavigateToSuppliersCommand}"
                                    AutomationProperties.Name="Manage suppliers">
                                <TextBlock Text="Suppliers" FontSize="13.5" />
                            </Button>
                            <Button Style="{StaticResource SidebarNavItemStyle}" Command="{Binding NavigateToLookupsCommand}" AutomationProperties.Name="Manage categories, brands and product units">
                                <TextBlock Text="Categories, Brands &amp; Units" FontSize="13.5" />
                            </Button>

                            <TextBlock Text="ACCOUNTS"
                                       Foreground="{StaticResource SidebarNavGroupBrush}"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       Padding="10,16,10,6" />
                            <Button Style="{StaticResource SidebarNavItemStyle}" Command="{Binding NavigateToReceiptsCommand}" AutomationProperties.Name="Record a customer receipt">
                                <TextBlock Text="Receipts" FontSize="13.5" />
                            </Button>
                            <Button Style="{StaticResource SidebarNavItemStyle}" Command="{Binding NavigateToPaymentsCommand}" AutomationProperties.Name="Record a supplier payment">
                                <TextBlock Text="Payments" FontSize="13.5" />
                            </Button>
                            <Button Style="{StaticResource SidebarNavItemStyle}" Command="{Binding NavigateToExpensesCommand}" AutomationProperties.Name="Record a business expense">
                                <TextBlock Text="Expenses" FontSize="13.5" />
                            </Button>
                            <Button Style="{StaticResource SidebarNavItemStyle}" Command="{Binding NavigateToCashBankCommand}" AutomationProperties.Name="View cash and bank balances">
                                <TextBlock Text="Cash &amp; Bank" FontSize="13.5" />
                            </Button>
                            <Button Style="{StaticResource SidebarNavItemStyle}" Command="{Binding NavigateToCustomerLedgerCommand}" AutomationProperties.Name="View customer ledger">
                                <TextBlock Text="Customer Ledger" FontSize="13.5" />
                            </Button>
                            <Button Style="{StaticResource SidebarNavItemStyle}" Command="{Binding NavigateToSupplierLedgerCommand}" AutomationProperties.Name="View supplier ledger">
                                <TextBlock Text="Supplier Ledger" FontSize="13.5" />
                            </Button>

                            <!-- Nav Group: REPORTS -->
                            <TextBlock Text="REPORTS"
                                       Foreground="{StaticResource SidebarNavGroupBrush}"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       Padding="10,16,10,6" />

                            <!-- Nav Item: Reports Dashboard -->
                            <Button Style="{StaticResource SidebarNavItemStyle}"
                                    Command="{Binding NavigateToReportsCommand}"
                                    AutomationProperties.Name="Navigate to Reports Dashboard"
                                    AutomationProperties.HelpText="Open reports and analytics dashboard">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconChartGeometry}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6"
                                          Width="17" Height="17"
                                          Margin="0,0,10,0"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Reports Dashboard"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               FontSize="13.5"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <TextBlock Text="SYSTEM" Foreground="{StaticResource SidebarNavGroupBrush}" FontSize="10.5" FontWeight="Bold" Padding="10,16,10,6" />
                            <Button Style="{StaticResource SidebarNavItemStyle}" Command="{Binding NavigateToBackupCommand}" AutomationProperties.Name="Create or restore a database backup">
                                <TextBlock Text="Backup &amp; Restore" FontSize="13.5" />
                            </Button>
                            <Button Style="{StaticResource SidebarNavItemStyle}" Command="{Binding NavigateToAdministrationCommand}" AutomationProperties.Name="Manage administrators and review activity">
                                <TextBlock Text="Administration &amp; Activity" FontSize="13.5" />
                            </Button>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- SIDEBAR FOOTER -->
                    <Border Grid.Row="2"
                            Padding="14,14"
                            BorderBrush="{StaticResource SidebarBorderBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock TextAlignment="Center"
                                       FontSize="11.5"
                                       Foreground="{StaticResource SidebarNavGroupBrush}">
                                <Run Text="Developed by " />
                                <Run Text="COMSTECH.Solutions" FontWeight="Bold" Foreground="#9FB2C8" />
                            </TextBlock>

                            <Button Content="Help &amp; Tour"
                                    Click="ShowTourButton_Click"
                                    Style="{StaticResource SidebarActionButtonStyle}"
                                    Margin="0,12,0,2"
                                    BorderThickness="1"
                                    ToolTip="Replay the getting-started tour"
                                    AutomationProperties.Name="Open help and app tour" />

                            <!-- Offline Desktop Status Badge -->
                            <Border Background="{StaticResource SidebarHoverBrush}"
                                    CornerRadius="12"
                                    Padding="8,4"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8"
                                             Fill="{StaticResource GreenBrush}"
                                             Margin="0,0,6,0"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="Offline Desktop (SQLite WAL)"
                                               Foreground="#A0B0C0"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- MAIN VIEWPORT (Topbar + Content Area) -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="68" /> <!-- Header toolbar -->
                    <RowDefinition Height="*" />  <!-- Main Workspace -->
                </Grid.RowDefinitions>

                <!-- TOPBAR (WindowChrome caption area with HitTestVisible interactive controls) -->
                <Border Grid.Row="0"
                        Height="68"
                        Background="#FFFFFF"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="24,0"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Compact brand block -->
                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Margin="0,0,20,0"
                                    MaxWidth="205">
                            <TextBlock Text="Ali Traders"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Foreground="#172B4D"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Wholesale &amp; Distribution ERP"
                                       Margin="0,1,0,0"
                                       FontSize="11.5"
                                       Foreground="#64748B"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Flexible search stays centered and yields space to essential actions. -->
                        <Border Grid.Column="1"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="12,0"
                                Margin="8,0"
                                MinWidth="110"
                                MaxWidth="440"
                                Height="42"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                SnapsToDevicePixels="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F8FAFC" />
                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=GlobalSearchBox}" Value="True">
                                            <Setter Property="Background" Value="#FFFFFF" />
                                            <Setter Property="BorderBrush" Value="#2563EB" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="{StaticResource IconSearchGeometry}"
                                      Stroke="#64748B"
                                      StrokeThickness="1.8"
                                      Width="15" Height="15"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                                <TextBox x:Name="GlobalSearchBox" Grid.Column="1"
                                         Text=""
                                         ToolTip="Search products, customers, or suppliers. Press Enter to open a match."
                                         BorderThickness="0" Background="Transparent"
                                         Foreground="#172B4D"
                                         FontSize="13" VerticalAlignment="Center"
                                         KeyDown="GlobalSearchBox_KeyDown"
                                         AutomationProperties.Name="Search products, customers, or suppliers" />
                                <TextBlock Grid.Column="1" Text="Search products, customers, suppliers…"
                                           Foreground="#64748B" FontSize="12.5"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=GlobalSearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Grid.Column="2"
                                        Background="#FFFFFF"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="5,2"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl K"
                                               FontSize="10.5"
                                               Foreground="#64748B"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Toolbar actions -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    WindowChrome.IsHitTestVisibleInChrome="True">

                            <!-- Notification Bell -->
                            <Button x:Name="NotificationButton"
                                    Click="NotificationButton_Click"
                                    ToolTip="View notifications"
                                    AutomationProperties.Name="Open notifications"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    Cursor="Hand"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Style="{StaticResource TopbarIconButtonStyle}">
                                <Grid Width="38" Height="38">
                                    <Path Data="{StaticResource IconBellGeometry}"
                                          Stroke="{StaticResource MutedBrush}"
                                          StrokeThickness="1.8"
                                          Width="18" Height="18"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                    <Border x:Name="NotificationBadge"
                                            Width="8" Height="8"
                                            CornerRadius="4"
                                            Background="{StaticResource RedBrush}"
                                            BorderBrush="#FFFFFF"
                                            BorderThickness="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,5,7,0"
                                            Visibility="Collapsed" />
                                </Grid>
                            </Button>

                            <Popup x:Name="NotificationPopup"
                                   PlacementTarget="{Binding ElementName=NotificationButton}"
                                   Placement="Bottom"
                                   HorizontalOffset="-174"
                                   VerticalOffset="8"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border Width="300"
                                        Padding="16"
                                        Background="#FFFFFF"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Effect="{StaticResource CardDropShadow}"
                                        SnapsToDevicePixels="True">
                                    <StackPanel>
                                        <TextBlock Text="NOTIFICATIONS"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock x:Name="NotificationSummaryText"
                                                   Text="Checking stock alerts…"
                                                   Margin="0,6,0,3"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="NotificationDetailText"
                                                   Text="Current stock alerts from your saved product records."
                                                   Margin="0,0,0,10"
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextWrapping="Wrap" />
                                        <ItemsControl x:Name="LowStockItemsControl" Visibility="Collapsed">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="9,7"
                                                            Margin="0,2"
                                                            Background="#FFF8F0"
                                                            BorderBrush="#F5E3C8"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                        <DockPanel LastChildFill="True">
                                                            <TextBlock DockPanel.Dock="Right"
                                                                       Text="{Binding CurrentStock, StringFormat={}{0:0.##}}"
                                                                       Margin="10,0,0,0"
                                                                       Foreground="#9A5B0A"
                                                                       FontSize="11"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding ProductName}"
                                                                       Foreground="{StaticResource TextBrush}"
                                                                       FontSize="12"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button x:Name="ViewInventoryFromNotificationsButton"
                                                Content="Review inventory"
                                                Click="OpenInventoryFromNotifications_Click"
                                                HorizontalContentAlignment="Center"
                                                Margin="0,10,0,0"
                                                Padding="10,7"
                                                MinHeight="36"
                                                Style="{StaticResource BtnPrimaryStyle}"
                                                Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <!-- User profile menu: opening the profile never signs out by itself. -->
                            <Button x:Name="UserProfileButton"
                                    Click="UserProfileButton_Click"
                                    Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="8,5"
                                    Cursor="Hand" VerticalAlignment="Center" Margin="0,0,12,0"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    ToolTip="Account options" AutomationProperties.Name="Open administrator account menu"
                                    Style="{StaticResource TopbarProfileButtonStyle}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="34" Height="34"
                                            CornerRadius="17"
                                            Background="{StaticResource BlueBrush}"
                                            Margin="0,0,8,0">
                                        <TextBlock Text="{Binding UserInitials}"
                                                   Foreground="#FFFFFF"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,6,0" MaxWidth="94">
                                        <TextBlock Text="{Binding UserDisplayName}"
                                                   FontWeight="Bold"
                                                   FontSize="12.5"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="Administrator"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                    <Path Data="{StaticResource IconChevronDownGeometry}"
                                          Stroke="{StaticResource MutedBrush}"
                                          StrokeThickness="1.8"
                                          Width="10" Height="10"
                                          VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Popup x:Name="ProfileMenuPopup"
                                   PlacementTarget="{Binding ElementName=UserProfileButton}"
                                   Placement="Bottom"
                                   HorizontalOffset="-54"
                                   VerticalOffset="8"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <Border Width="230"
                                        Padding="16"
                                        Background="#FFFFFF"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Effect="{StaticResource CardDropShadow}"
                                        SnapsToDevicePixels="True">
                                    <StackPanel>
                                        <TextBlock Text="ACCOUNT"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Text="{Binding UserDisplayName}"
                                                   Margin="0,5,0,1"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="Administrator"
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}" />
                                        <Border Height="1"
                                                Margin="0,13,0,9"
                                                Background="{StaticResource BorderBrush}" />
                                        <Button Content="Sign out"
                                                Click="SignOutButton_Click"
                                                HorizontalContentAlignment="Left"
                                                Padding="10,8"
                                                MinHeight="38"
                                                Background="#FFF7F7"
                                                BorderBrush="#F4D2D2"
                                                Foreground="#B42318"
                                                FontSize="13"
                                                AutomationProperties.Name="Sign out of SOFT2027" />
                                    </StackPanel>
                                </Border>
                            </Popup>

                        </StackPanel>

                        <!-- Window controls remain visually separate from application actions. -->
                        <Border Grid.Column="3"
                                Margin="8,0,0,0"
                                Padding="12,0,0,0"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1,0,0,0"
                                VerticalAlignment="Stretch"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Minimize -->
                            <Button Click="MinimizeButton_Click"
                                    Width="38" Height="38"
                                    Content="—"
                                    FontSize="12"
                                    Cursor="Hand"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    ToolTip="Minimize Window"
                                    AutomationProperties.Name="Minimize Window"
                                    Style="{StaticResource WindowControlButtonStyle}" />

                            <!-- Maximize -->
                            <Button Click="MaximizeButton_Click"
                                    Width="38" Height="38"
                                    Style="{StaticResource WindowMaximizeButtonStyle}"
                                    FontSize="13"
                                    Cursor="Hand"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    AutomationProperties.Name="Maximize or restore window" />

                            <!-- Close -->
                            <Button Click="CloseButton_Click"
                                    Width="38" Height="38"
                                    Content="✕"
                                    FontSize="12"
                                    Cursor="Hand"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    ToolTip="Close Window"
                                    AutomationProperties.Name="Close Window"
                                    Style="{StaticResource WindowCloseButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- MAIN WORKSPACE: ScrollViewer wrapping ContentControl restores mouse wheel scrolling -->
                <ScrollViewer x:Name="MainWorkspaceScrollViewer" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="24"
                              Focusable="False">
                    <ContentControl Content="{Binding CurrentViewModel}"
                                    HorizontalAlignment="Stretch"
                                    MaxWidth="1200"
                                    AutomationProperties.Name="Main Workspace View Area" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ================================================================= -->
        <!-- LOGIN VIEW: Visible when IsAuthenticated == False                 -->
        <!-- ================================================================= -->
        <views:LoginView>
            <views:LoginView.Style>
                <Style TargetType="views:LoginView">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:LoginView.Style>
        </views:LoginView>

        <!-- Custom chrome has no native caption buttons. Keep window controls
             available while the login screen covers the authenticated shell. -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,6,10,0"
                    Panel.ZIndex="10"
                    WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Button Click="MinimizeButton_Click" Width="36" Height="34"
                    Content="—" FontSize="12"
                    Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True"
                    ToolTip="Minimize Window" AutomationProperties.Name="Minimize Window"
                    Style="{StaticResource WindowControlButtonStyle}" />
            <Button Click="MaximizeButton_Click" Width="36" Height="34"
                    Style="{StaticResource WindowMaximizeButtonStyle}"
                    FontSize="13"
                    Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True"
                    AutomationProperties.Name="Maximize or restore window" />
            <Button Click="CloseButton_Click" Width="36" Height="34"
                    Content="✕" FontSize="12"
                    Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True"
                    ToolTip="Close Window" AutomationProperties.Name="Close Window"
                    Style="{StaticResource WindowCloseButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
