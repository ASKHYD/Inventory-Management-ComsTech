<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:SOFT2027.UI.Behaviors">

    <!-- ========================================================================= -->
    <!-- 1. COLOR TOKENS & SOLID COLOR BRUSHES                                     -->
    <!-- Direct extraction from soft2027-prototype (2).html CSS variables          -->
    <!-- ========================================================================= -->

    <!-- Navy Family (Brand / Sidebar / Dark Actions) -->
    <Color x:Key="ColorNavy">#17194A</Color>
    <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource BrandNavyColor}" />

    <Color x:Key="ColorNavy2">#20235C</Color>
    <SolidColorBrush x:Key="Navy2Brush" Color="{StaticResource ColorNavy2}" />

    <Color x:Key="ColorNavy3">#101238</Color>
    <SolidColorBrush x:Key="Navy3Brush" Color="{StaticResource ColorNavy3}" />

    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#17194A" Offset="0.0" />
        <GradientStop Color="#20235C" Offset="0.6" />
        <GradientStop Color="#17194A" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Blue Family (Primary Accent / Focus / Active State) -->
    <Color x:Key="ColorBlue">#17194A</Color>
    <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BrandNavyColor}" />

    <Color x:Key="ColorBlueDark">#101238</Color>
    <SolidColorBrush x:Key="BlueDarkBrush" Color="{StaticResource ColorBlueDark}" />

    <Color x:Key="ColorBlueLight">#EEF0FA</Color>
    <SolidColorBrush x:Key="BlueLightBrush" Color="{StaticResource ColorBlueLight}" />

    <!-- Neutral & Surface Tokens -->
    <Color x:Key="ColorBackground">#F5F6FA</Color>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource ColorBackground}" />

    <Color x:Key="ColorCard">#FFFFFF</Color>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource ColorCard}" />

    <Color x:Key="ColorText">#1F2937</Color>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource ColorText}" />

    <Color x:Key="ColorMuted">#475569</Color>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource ColorMuted}" />

    <Color x:Key="ColorFaint">#5B6472</Color>
    <SolidColorBrush x:Key="FaintBrush" Color="{StaticResource ColorFaint}" />

    <Color x:Key="ColorBorder">#CBD5E1</Color>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorBorder}" />

    <Color x:Key="ColorBorderDark">#94A3B8</Color>
    <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource ColorBorderDark}" />

    <Color x:Key="ColorSurfaceSubtle">#F8FAFC</Color>
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="{StaticResource ColorSurfaceSubtle}" />

    <Color x:Key="ColorTableRowBorder">#E2E8F0</Color>
    <SolidColorBrush x:Key="TableRowBorderBrush" Color="{StaticResource ColorTableRowBorder}" />

    <!-- Semantic Feedback Palettes -->
    <!-- Green -->
    <Color x:Key="ColorGreen">#166534</Color>
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource ColorGreen}" />
    <Color x:Key="ColorGreenLight">#E8F5EC</Color>
    <SolidColorBrush x:Key="GreenLightBrush" Color="{StaticResource ColorGreenLight}" />
    <Color x:Key="ColorGreenDark">#166534</Color>
    <SolidColorBrush x:Key="GreenDarkBrush" Color="{StaticResource ColorGreenDark}" />

    <!-- Red -->
    <Color x:Key="ColorRed">#C62828</Color>
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource ColorRed}" />
    <Color x:Key="ColorRedLight">#FDECEC</Color>
    <SolidColorBrush x:Key="RedLightBrush" Color="{StaticResource ColorRedLight}" />
    <Color x:Key="ColorRedDark">#9B1C1C</Color>
    <SolidColorBrush x:Key="RedDarkBrush" Color="{StaticResource ColorRedDark}" />

    <!-- Amber -->
    <Color x:Key="ColorAmber">#B45309</Color>
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource ColorAmber}" />
    <Color x:Key="ColorAmberLight">#FFF4E5</Color>
    <SolidColorBrush x:Key="AmberLightBrush" Color="{StaticResource ColorAmberLight}" />
    <Color x:Key="ColorAmberDark">#92400E</Color>
    <SolidColorBrush x:Key="AmberDarkBrush" Color="{StaticResource ColorAmberDark}" />

    <!-- Sidebar Element Tokens -->
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#C8D4E2" />
    <SolidColorBrush x:Key="SidebarTagBrush" Color="#A0AEC0" />
    <SolidColorBrush x:Key="SidebarNavGroupBrush" Color="#A0AEC0" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#24FFFFFF" />

    <!-- Consistent, readable tooltip treatment across the desktop application. -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#102438" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#29445D" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MaxWidth" Value="300" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               TextWrapping="Wrap"
                               MaxWidth="278"
                               Foreground="#FFFFFF"
                               FontFamily="Segoe UI"
                               FontSize="12" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A keyboard-only adorner avoids leaving a focus ring after mouse clicks. -->
    <Style x:Key="KeyboardFocusVisualStyle" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border Margin="1" BorderBrush="{StaticResource FocusRingBrush}"
                            BorderThickness="2" CornerRadius="6" IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PageRootGridStyle" TargetType="Grid">
        <Setter Property="Margin" Value="{StaticResource Space24}" />
    </Style>
    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TypePageTitle}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
    </Style>
    <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TypeBody}" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="PageContentCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceWhiteBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MaxWidth" Value="1200" />
        <Setter Property="Padding" Value="{StaticResource Space24}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- Reusable semantic message containers: icon and text are both present. -->
    <Style x:Key="MessageInfoBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="#EEF0FA" />
        <Setter Property="BorderBrush" Value="{StaticResource NavyBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="{StaticResource Space12}" />
    </Style>
    <Style x:Key="MessageSuccessBorderStyle" TargetType="Border" BasedOn="{StaticResource MessageInfoBorderStyle}">
        <Setter Property="Background" Value="{StaticResource SuccessSurfaceTokenBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SuccessTokenBrush}" />
    </Style>
    <Style x:Key="MessageWarningBorderStyle" TargetType="Border" BasedOn="{StaticResource MessageInfoBorderStyle}">
        <Setter Property="Background" Value="{StaticResource WarningSurfaceTokenBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WarningTokenBrush}" />
    </Style>
    <Style x:Key="MessageErrorBorderStyle" TargetType="Border" BasedOn="{StaticResource MessageInfoBorderStyle}">
        <Setter Property="Background" Value="{StaticResource ErrorSurfaceTokenBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ErrorTokenBrush}" />
    </Style>
    <DataTemplate x:Key="MessageInfoTemplate">
        <DockPanel LastChildFill="True"><TextBlock Text="i" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DockPanel>
    </DataTemplate>
    <DataTemplate x:Key="MessageSuccessTemplate">
        <DockPanel LastChildFill="True"><TextBlock Text="✓" FontWeight="Bold" Foreground="{StaticResource SuccessTokenBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DockPanel>
    </DataTemplate>
    <DataTemplate x:Key="MessageWarningTemplate">
        <DockPanel LastChildFill="True"><TextBlock Text="!" FontWeight="Bold" Foreground="{StaticResource WarningTokenBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DockPanel>
    </DataTemplate>
    <DataTemplate x:Key="MessageErrorTemplate">
        <DockPanel LastChildFill="True"><TextBlock Text="×" FontWeight="Bold" Foreground="{StaticResource ErrorTokenBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource ErrorTokenBrush}"/></DockPanel>
    </DataTemplate>

    <!-- ========================================================================= -->
    <!-- 2. SHADOW EFFECTS                                                         -->
    <!-- ========================================================================= -->
    <DropShadowEffect x:Key="CardDropShadow"
                      BlurRadius="10"
                      ShadowDepth="2"
                      Direction="270"
                      Color="#0D1B2A"
                      Opacity="0.06" />

    <DropShadowEffect x:Key="PopupDropShadow"
                      BlurRadius="14"
                      ShadowDepth="3"
                      Direction="270"
                      Color="#0D1B2A"
                      Opacity="0.14" />

    <!-- ========================================================================= -->
