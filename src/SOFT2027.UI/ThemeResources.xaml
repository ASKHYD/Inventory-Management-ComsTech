<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================= -->
    <!-- 1. COLOR TOKENS & SOLID COLOR BRUSHES                                     -->
    <!-- Direct extraction from soft2027-prototype (2).html CSS variables          -->
    <!-- ========================================================================= -->

    <!-- Navy Family (Brand / Sidebar / Dark Actions) -->
    <Color x:Key="ColorNavy">#0D1B2A</Color>
    <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource ColorNavy}" />

    <Color x:Key="ColorNavy2">#13253A</Color>
    <SolidColorBrush x:Key="Navy2Brush" Color="{StaticResource ColorNavy2}" />

    <Color x:Key="ColorNavy3">#1B3350</Color>
    <SolidColorBrush x:Key="Navy3Brush" Color="{StaticResource ColorNavy3}" />

    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0D1B2A" Offset="0.0" />
        <GradientStop Color="#13253A" Offset="0.6" />
        <GradientStop Color="#17456E" Offset="1.3" />
    </LinearGradientBrush>

    <!-- Blue Family (Primary Accent / Focus / Active State) -->
    <Color x:Key="ColorBlue">#1F5FA0</Color>
    <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource ColorBlue}" />

    <Color x:Key="ColorBlueDark">#17557F</Color>
    <SolidColorBrush x:Key="BlueDarkBrush" Color="{StaticResource ColorBlueDark}" />

    <Color x:Key="ColorBlueLight">#E8F1F9</Color>
    <SolidColorBrush x:Key="BlueLightBrush" Color="{StaticResource ColorBlueLight}" />

    <!-- Neutral & Surface Tokens -->
    <Color x:Key="ColorBackground">#F3F5F8</Color>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource ColorBackground}" />

    <Color x:Key="ColorCard">#FFFFFF</Color>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource ColorCard}" />

    <Color x:Key="ColorText">#1A2433</Color>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource ColorText}" />

    <Color x:Key="ColorMuted">#64748B</Color>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource ColorMuted}" />

    <Color x:Key="ColorFaint">#94A3B8</Color>
    <SolidColorBrush x:Key="FaintBrush" Color="{StaticResource ColorFaint}" />

    <Color x:Key="ColorBorder">#E2E8F0</Color>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorBorder}" />

    <Color x:Key="ColorBorderDark">#CBD5E1</Color>
    <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource ColorBorderDark}" />

    <Color x:Key="ColorSurfaceSubtle">#F8FAFC</Color>
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="{StaticResource ColorSurfaceSubtle}" />

    <Color x:Key="ColorTableRowBorder">#EEF2F6</Color>
    <SolidColorBrush x:Key="TableRowBorderBrush" Color="{StaticResource ColorTableRowBorder}" />

    <!-- Semantic Feedback Palettes -->
    <!-- Green -->
    <Color x:Key="ColorGreen">#16A34A</Color>
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource ColorGreen}" />
    <Color x:Key="ColorGreenLight">#E7F7EE</Color>
    <SolidColorBrush x:Key="GreenLightBrush" Color="{StaticResource ColorGreenLight}" />
    <Color x:Key="ColorGreenDark">#0F7A37</Color>
    <SolidColorBrush x:Key="GreenDarkBrush" Color="{StaticResource ColorGreenDark}" />

    <!-- Red -->
    <Color x:Key="ColorRed">#DC2626</Color>
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource ColorRed}" />
    <Color x:Key="ColorRedLight">#FDECEC</Color>
    <SolidColorBrush x:Key="RedLightBrush" Color="{StaticResource ColorRedLight}" />
    <Color x:Key="ColorRedDark">#B91C1C</Color>
    <SolidColorBrush x:Key="RedDarkBrush" Color="{StaticResource ColorRedDark}" />

    <!-- Amber -->
    <Color x:Key="ColorAmber">#D97706</Color>
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource ColorAmber}" />
    <Color x:Key="ColorAmberLight">#FDF3E3</Color>
    <SolidColorBrush x:Key="AmberLightBrush" Color="{StaticResource ColorAmberLight}" />
    <Color x:Key="ColorAmberDark">#B45309</Color>
    <SolidColorBrush x:Key="AmberDarkBrush" Color="{StaticResource ColorAmberDark}" />

    <!-- Sidebar Element Tokens -->
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#C8D4E2" />
    <SolidColorBrush x:Key="SidebarTagBrush" Color="#8FA3BA" />
    <SolidColorBrush x:Key="SidebarNavGroupBrush" Color="#6B7F97" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#14FFFFFF" />

    <!-- Consistent, readable tooltip treatment across the desktop application. -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#102438" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#29445D" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MaxWidth" Value="300" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               TextWrapping="Wrap"
                               MaxWidth="278"
                               Foreground="#FFFFFF"
                               FontFamily="Segoe UI"
                               FontSize="12" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================================= -->
    <!-- 2. SHADOW EFFECTS                                                         -->
    <!-- ========================================================================= -->
    <DropShadowEffect x:Key="CardDropShadow"
                      BlurRadius="10"
                      ShadowDepth="2"
                      Direction="270"
                      Color="#0D1B2A"
                      Opacity="0.06" />

    <DropShadowEffect x:Key="PopupDropShadow"
                      BlurRadius="14"
                      ShadowDepth="3"
                      Direction="270"
                      Color="#0D1B2A"
                      Opacity="0.14" />

    <!-- ========================================================================= -->
    <!-- 3. PROTOTYPE VECTOR ICON GEOMETRIES (24x24 viewBox standard)               -->
    <!-- ========================================================================= -->
    <StreamGeometry x:Key="IconDashboardGeometry">M3,3 H10 V12 H3 Z M14,3 H21 V8 H14 Z M14,12 H21 V21 H14 Z M3,16 H10 V21 H3 Z</StreamGeometry>
    <StreamGeometry x:Key="IconSaleGeometry">M6,2 L3,6 V20 A2,2 0 0,0 5,22 H19 A2,2 0 0,0 21,20 V6 L18,2 Z M3,6 H21 M16,10 A4,4 0 0,1 8,10</StreamGeometry>
    <StreamGeometry x:Key="IconChartGeometry">M18,20 V10 M12,20 V4 M6,20 V14</StreamGeometry>
    <StreamGeometry x:Key="IconSearchGeometry">M11,4 A7,7 0 1,1 11,18 A7,7 0 0,1 11,4 Z M16,16 L21,21</StreamGeometry>
    <StreamGeometry x:Key="IconBellGeometry">M18,8 A6,6 0 0,0 6,8 C6,15 3,17 3,17 H21 S18,15 18,8 M13.7,21 A2,2 0 0,1 10.3,21</StreamGeometry>
    <StreamGeometry x:Key="IconChevronDownGeometry">M6,9 L12,15 L18,9</StreamGeometry>
    <StreamGeometry x:Key="IconBoxGeometry">M21,8 A2,2 0 0,0 20,6.27 L13,2.27 A2,2 0 0,0 11,2.27 L4,6.27 A2,2 0 0,0 3,8 V16 A2,2 0 0,0 4,17.73 L11,21.73 A2,2 0 0,0 13,21.73 L20,17.73 A2,2 0 0,0 21,16 Z M3.3,7 L12,12 L20.7,7 M12,22 V12</StreamGeometry>
    <StreamGeometry x:Key="IconUsersGeometry">M17,21 V19 A4,4 0 0,0 13,15 H5 A4,4 0 0,0 1,19 V21 M9,11 A4,4 0 1,0 9,3 A4,4 0 0,0 9,11 Z M23,21 V19 A4,4 0 0,0 20,15.1 M16,3.1 A4,4 0 0,1 16,10.9</StreamGeometry>

    <!-- ========================================================================= -->
    <!-- 4. BASE TYPOGRAPHY & TEXTBOX STYLES                                       -->
    <!-- ========================================================================= -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Style.Triggers>
            <!-- TextBlock's implicit foreground was overriding button foregrounds,
                 making navigation labels dark on the navy sidebar. -->
            <DataTrigger Binding="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Value="{x:Null}">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="12,0,12,0"
                                          VerticalAlignment="Center" />
                            <TextBlock x:Name="Placeholder"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Margin="12,0,12,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================================= -->
    <!-- 5. BUTTON STYLES (.btn, .btn-primary, .btn-dark, .btn-danger, .btn-green) -->
    <!-- ========================================================================= -->
    
    <!-- Base .btn Style -->
    <Style x:Key="BtnStyle" TargetType="Button">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="ButtonContentPresenter"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="#2563EB" />
                            <Setter TargetName="RootBorder" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#EEF2F6" />
                <Setter Property="BorderBrush" Value="#C7D1DD" />
                <Setter Property="Foreground" Value="#526173" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Implicit Button Style defaults to .btn -->
    <Style TargetType="Button" BasedOn="{StaticResource BtnStyle}">
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource TableRowBorderBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BlueBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#EEF2F6" />
                <Setter Property="BorderBrush" Value="#C7D1DD" />
                <Setter Property="Foreground" Value="#526173" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- .btn-primary -->
    <Style x:Key="BtnPrimaryStyle" TargetType="Button" BasedOn="{StaticResource BtnStyle}">
        <Setter Property="Background" Value="{StaticResource BlueBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BlueBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#134469" />
                <Setter Property="BorderBrush" Value="#134469" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#EEF2F6" />
                <Setter Property="BorderBrush" Value="#C7D1DD" />
                <Setter Property="Foreground" Value="#526173" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- .btn-dark -->
    <Style x:Key="BtnDarkStyle" TargetType="Button" BasedOn="{StaticResource BtnStyle}">
        <Setter Property="Background" Value="{StaticResource NavyBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource NavyBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Navy3Brush}" />
                <Setter Property="BorderBrush" Value="{StaticResource Navy3Brush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#EEF2F6" />
                <Setter Property="BorderBrush" Value="#C7D1DD" />
                <Setter Property="Foreground" Value="#526173" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- .btn-danger -->
    <Style x:Key="BtnDangerStyle" TargetType="Button" BasedOn="{StaticResource BtnStyle}">
        <Setter Property="Background" Value="{StaticResource RedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#991B1B" />
                <Setter Property="BorderBrush" Value="#991B1B" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#EEF2F6" />
                <Setter Property="BorderBrush" Value="#C7D1DD" />
                <Setter Property="Foreground" Value="#526173" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- .btn-green -->
    <Style x:Key="BtnGreenStyle" TargetType="Button" BasedOn="{StaticResource BtnStyle}">
        <Setter Property="Background" Value="{StaticResource GreenBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GreenBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#14532D" />
                <Setter Property="BorderBrush" Value="#14532D" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#EEF2F6" />
                <Setter Property="BorderBrush" Value="#C7D1DD" />
                <Setter Property="Foreground" Value="#526173" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Sidebar Nav Item Style -->
    <Style x:Key="SidebarNavItemStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Margin" Value="0,1,0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="NavContentPresenter"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <Border x:Name="FocusRing" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="6" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource BlueDarkBrush}" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="#93C5FD" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="NavContentPresenter" Property="TextElement.Foreground" Value="{StaticResource SidebarTagBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar footer action preserves its color without pointer-dependent styling. -->
    <Style x:Key="SidebarActionButtonStyle" TargetType="Button" BasedOn="{StaticResource BtnStyle}">
        <Setter Property="Background" Value="#263F58" />
        <Setter Property="BorderBrush" Value="#48627B" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="18,7" />
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#1B344D" />
                <Setter Property="BorderBrush" Value="#6B87A1" />
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#243447" />
                <Setter Property="BorderBrush" Value="#526377" />
                <Setter Property="Foreground" Value="#ADB8C4" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ========================================================================= -->
    <!-- 6. CARD / BORDER STYLE (.card)                                            -->
    <!-- ========================================================================= -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Effect" Value="{StaticResource CardDropShadow}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ========================================================================= -->
    <!-- 7. COMBOBOX STYLES (Non-clipping Popup, AllowsTransparency, Item States)   -->
    <!-- ========================================================================= -->
    
    <!-- ComboBoxItem Style -->
    <Style x:Key="DefaultComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="4"
                            Margin="3,1"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BlueLightBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource BlueBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox ToggleButton -->
    <Style x:Key="ComboBoxToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="TemplateRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <Grid HorizontalAlignment="Right" Width="32">
                            <Path x:Name="Arrow"
                                  Data="{StaticResource IconChevronDownGeometry}"
                                  Stroke="{StaticResource MutedBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="11"
                                  Height="11"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                            <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource BlueBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="TemplateRoot" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Base ComboBox Style -->
    <Style TargetType="ComboBox">
        <Setter Property="ItemContainerStyle" Value="{StaticResource DefaultComboBoxItemStyle}" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="12,0,32,0" />
        <Setter Property="MaxDropDownHeight" Value="280" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid SnapsToDevicePixels="True">
                        <!-- Toggle Button Header -->
                        <ToggleButton x:Name="ToggleButton"
                                      Style="{StaticResource ComboBoxToggleButtonStyle}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />

                        <!-- Selected Item Display -->
                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="12,0,32,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left" />

                        <!-- Required editable part: without this, editable/searchable
                             ComboBoxes cannot display or accept typed text. -->
                        <TextBox x:Name="PART_EditableTextBox"
                                 Style="{x:Null}"
                                 Margin="0,0,32,0"
                                 Visibility="Hidden"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{TemplateBinding Foreground}"
                                 FontFamily="{TemplateBinding FontFamily}"
                                 FontSize="{TemplateBinding FontSize}"
                                 Padding="12,0,32,0"
                                 VerticalContentAlignment="Center"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"
                                 Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock x:Name="ComboPlaceholder"
                                   Text="{TemplateBinding Tag}"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Margin="12,0,32,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed" />

                        <!-- Popup Menu: Explicitly non-clipping, AllowsTransparency="True", DropShadow isolation -->
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Bottom"
                               Focusable="False"
                               PopupAnimation="Fade"
                               VerticalOffset="4">
                            <!-- Non-clipping container with padding margin for drop shadow -->
                            <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                  MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border x:Name="DropDownBorder"
                                        Margin="0,0,8,8"
                                        Background="#FFFFFF"
                                        BorderBrush="{StaticResource BorderDarkBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Effect="{StaticResource PopupDropShadow}"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer Margin="2"
                                                  CanContentScroll="True"
                                                  Focusable="False">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding SelectedIndex, RelativeSource={RelativeSource TemplatedParent}}" Value="-1" />
                                <Condition Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="ComboPlaceholder" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ComboPlaceholder" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding SelectedIndex, RelativeSource={RelativeSource TemplatedParent}}" Value="-1" />
                                <Condition Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="ComboPlaceholder" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================================= -->
    <!-- 8. DATAGRID STYLES (Matching .tbl thead th and .tbl tbody td)              -->
    <!-- ========================================================================= -->

    <!-- Column Header (.tbl thead th) -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- DataGrid Row (.tbl tbody tr) -->
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource TableRowBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource BlueLightBrush}" />
                <Setter Property="Foreground" Value="{StaticResource BlueBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- DataGrid Cell (.tbl tbody td) -->
    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent"
                            BorderThickness="0"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource BlueBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Base DataGrid Container Style -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource TableRowBorderBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="MaxHeight" Value="480" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    </Style>

</ResourceDictionary>
